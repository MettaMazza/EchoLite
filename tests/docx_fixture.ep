import "../src/docx_native"

define docx_fixture with path and text and mode:
    set library to ep_dlopen("/usr/lib/libarchive.2.dylib")
    set archive to ep_dlcall0(ep_dlsym(library and "archive_write_new"))
    ep_dlcall1(ep_dlsym(library and "archive_write_set_format_zip") and archive)
    if ep_dlcall2(ep_dlsym(library and "archive_write_open_filename") and archive and path) != 0:
        return 0
    set xml to concat("<w:document xmlns:w='http://schemas.openxmlformats.org/wordprocessingml/2006/main'><w:body><w:p><w:r><w:t>" and concat(text and "</w:t></w:r></w:p></w:body></w:document>"))
    if mode == 3:
        set xml to "<!DOCTYPE a [<!ENTITY x SYSTEM 'file:///etc/passwd'>]><a/>"
    set i to 0
    set limit to 1
    if mode == 1 || mode == 2:
        set limit to 2
    repeat while i < limit:
        set entry to ep_dlcall0(ep_dlsym(library and "archive_entry_new"))
        set name to "word/document.xml"
        if mode == 1 && i == 1:
            set name to "word/vbaProject.bin"
        ep_dlcall2(ep_dlsym(library and "archive_entry_set_pathname") and entry and name)
        ep_dlcall2(ep_dlsym(library and "archive_entry_set_size") and entry and string_length(xml))
        ep_dlcall2(ep_dlsym(library and "archive_entry_set_filetype") and entry and 32768)
        ep_dlcall2(ep_dlsym(library and "archive_entry_set_perm") and entry and 384)
        set code to ep_dlcall2(ep_dlsym(library and "archive_write_header") and archive and entry)
        set written to ep_dlcall3(ep_dlsym(library and "archive_write_data") and archive and xml and string_length(xml))
        ep_dlcall1(ep_dlsym(library and "archive_entry_free") and entry)
        if code != 0 || written != string_length(xml):
            ep_dlcall1(ep_dlsym(library and "archive_write_free") and archive)
            return 0
        set i to i + 1
    set code to ep_dlcall1(ep_dlsym(library and "archive_write_close") and archive)
    ep_dlcall1(ep_dlsym(library and "archive_write_free") and archive)
    return code == 0
