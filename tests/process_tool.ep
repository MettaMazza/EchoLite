import "../src/process_tool"
import "fs"
import "os"
set checks to 0

define tool_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define main:
    set args to get_args()
    set home to get_list(args and 1)
    set helper to get_list(args and 2)
    set fixture to get_list(args and 3)
    set db to sql_open(concat(home and "/memory.sqlite3"))
    tool_assert(sql_execute(db and "CREATE TABLE metadata(key TEXT PRIMARY KEY,value TEXT); INSERT INTO metadata VALUES('cache_epoch','0'); CREATE TABLE turns(id INTEGER PRIMARY KEY,status TEXT); INSERT INTO turns VALUES(1,'pending'); CREATE TABLE tool_runs(id INTEGER PRIMARY KEY,turn_id INTEGER,name TEXT,arguments TEXT,status TEXT); CREATE TABLE process_operations(operation_id INTEGER PRIMARY KEY,epoch TEXT,status TEXT,result TEXT,stdout BLOB,stderr BLOB);") == 0 and "isolated process bridge state")
    set counter to concat(home and "/counter")
    set expression to result_cache_scalar(db and "SELECT json_object('argv',json_array(?,'once',?),'cwd',?,'timeout_seconds',5)" and [fixture,counter,home])
    sql_execute_params(db and "INSERT INTO tool_runs VALUES(1,1,'process_run',?,'running')" and [expression])
    set result to process_run(db and home and helper and expression and "0" and "1" and "")
    tool_assert(string_contains(result and "ONCE-294") and concat("actual supervised result: " and result))
    tool_assert(result_cache_scalar(db and "SELECT json_extract(?,'$.stdout_read_query')" and [result]) == "1:stdout:0" and "receipt supplies exact saved-output query")
    tool_assert(read_file(counter) == "1" and "command executed once")
    set replay to process_run(db and home and "/missing-helper" and expression and "0" and "1" and "")
    tool_assert(string_contains(replay and "\"replayed_receipt\":true") && read_file(counter) == "1" and "same operation replays without helper")
    sql_execute_params(db and "INSERT INTO tool_runs VALUES(2,1,'process_run',?,'running')" and [expression])
    set replay to process_run(db and home and helper and expression and "0" and "2" and "")
    tool_assert(string_contains(replay and "\"replayed_receipt\":true") && read_file(counter) == "1" and "duplicate turn command does not repeat effects")
    set cancel to concat(home and "/cancel-test")
    write_file(cancel and "cancel")
    sql_execute_params(db and "INSERT INTO tool_runs VALUES(3,1,'process_run',?,'running')" and [expression])
    set result to process_run(db and home and helper and expression and "0" and "3" and cancel)
    tool_assert(string_contains(result and "not_started") and "preexisting cancellation prevents launch")
    tool_assert(result_cache_scalar(db and "SELECT count(*) FROM process_operations WHERE operation_id=3" and []) == "0" and "cancelled operation not claimed")
    tool_assert(string_contains(process_run(db and home and helper and expression and "0" and "99" and "") and "matching pending journal") and "unbound command cannot execute")
    remove_file(cancel)
    set marker to concat(home and "/running-child")
    set expression to result_cache_scalar(db and "SELECT json_object('argv',json_array(?,'child',?),'cwd',?,'timeout_seconds',5)" and [fixture,marker,home])
    sql_execute_params(db and "INSERT INTO tool_runs VALUES(4,1,'process_run',?,'running')" and [expression])
    set canceller to process_start(fixture and ["cancel",cancel,marker])
    set result to process_run(db and home and helper and expression and "0" and "4" and cancel)
    tool_assert(file_exists(marker) && string_contains(result and "\"termination\":\"abandoned\"") and "cancellation after launch stops active command")
    set code to process_poll(canceller)
    repeat while code == 0 - 1:
        ep_dlcall1(ep_dlsym(native_system() and "usleep") and 10000)
        set code to process_poll(canceller)
    tool_assert(code == 0 && result_cache_scalar(db and "SELECT json_extract(result,'$.exit_code') FROM process_operations WHERE operation_id=4" and []) == "137" and "cancelled command termination durably recorded")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " native supervised process tool checks"))
    return 0
