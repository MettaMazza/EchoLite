import "../src/process_output"
import "../src/process_capture"
import "fs"
import "os"
set checks to 0

define guard_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define guard_wait with pid:
    set deadline to transport_now(native_system()) + 8000
    set code to process_poll(pid)
    repeat while code == 0 - 1 && transport_now(native_system()) < deadline:
        ep_dlcall1(ep_dlsym(native_system() and "usleep") and 10000)
        set code to process_poll(pid)
    return code

define main:
    set args to get_args()
    set home to get_list(args and 1)
    set helper to get_list(args and 2)
    set fixture to get_list(args and 3)
    set database to concat(home and "/memory.sqlite3")
    set db to sql_open(database)
    sql_execute(db and "PRAGMA foreign_keys=ON; PRAGMA synchronous=FULL;")
    guard_assert(sql_execute(db and "CREATE TABLE metadata(key TEXT PRIMARY KEY,value TEXT); INSERT INTO metadata VALUES('cache_epoch','0'); CREATE TABLE turns(id INTEGER PRIMARY KEY,status TEXT); INSERT INTO turns VALUES(1,'pending'); CREATE TABLE tool_runs(id INTEGER PRIMARY KEY,turn_id INTEGER REFERENCES turns(id),name TEXT,arguments TEXT,status TEXT); CREATE TABLE process_operations(operation_id INTEGER PRIMARY KEY REFERENCES tool_runs(id) ON DELETE CASCADE,epoch TEXT,status TEXT,result TEXT,stdout BLOB,stderr BLOB);") == 0 and "isolated supervisor journal")
    set counter to concat(home and "/counter.txt")
    set expression to result_cache_scalar(db and "SELECT json_object('argv',json_array(?,'once',?),'cwd',?,'timeout_seconds',5)" and [fixture,counter,home])
    sql_execute_params(db and "INSERT INTO tool_runs VALUES(1,1,'process_run',?,'running')" and [expression])
    set parent to process_start(fixture and ["parent",helper,database,expression,"1"])
    guard_assert(parent > 0 && guard_wait(parent) == 0 and "supervised command completes")
    guard_assert(read_file(counter) == "1" and "real command executed once")
    guard_assert(result_cache_scalar(db and "SELECT json_extract(result,'$.outcome') FROM process_operations WHERE operation_id=1" and []) == "completed" and "receipt durably completed")
    guard_assert(string_contains(result_cache_scalar(db and "SELECT CAST(stdout AS TEXT) FROM process_operations WHERE operation_id=1" and []) and "ONCE-294 café") and "real output persisted")
    set parent to process_start(fixture and ["parent",helper,database,expression,"1"])
    guard_assert(parent > 0 && guard_wait(parent) == 0 && read_file(counter) == "1" and "repeat supervisor returns receipt without side-effect replay")
    set marker to concat(home and "/child-pids.txt")
    set expression to result_cache_scalar(db and "SELECT json_object('argv',json_array(?,'child',?),'cwd',?,'timeout_seconds',30)" and [fixture,marker,home])
    sql_execute_params(db and "INSERT INTO tool_runs VALUES(2,1,'process_run',?,'running')" and [expression])
    set parent to process_start(fixture and ["parent",helper,database,expression,"2"])
    set deadline to transport_now(native_system()) + 8000
    repeat while file_exists(marker) == 0 && transport_now(native_system()) < deadline:
        ep_dlcall1(ep_dlsym(native_system() and "usleep") and 10000)
    guard_assert(file_exists(marker) and "command and descendant started")
    set pids to string_split(read_file(marker) and "\n")
    set owned to string_to_int(get_list(pids and 0))
    set descendant to string_to_int(get_list(pids and 1))
    set lock to private_lock(home and "state.lock")
    guard_assert(ep_dlcall2(ep_dlsym(native_system() and "flock") and lock and 6) != 0 and "supervisor holds shared state lease")
    ep_dlcall1(ep_dlsym(native_system() and "close") and lock)
    ep_dlcall2(ep_dlsym(native_system() and "kill") and parent and 9)
    guard_assert(guard_wait(parent) == 137 and "launcher actually killed")
    set deadline to transport_now(native_system()) + 8000
    set finished to ""
    repeat while finished != "completed" && transport_now(native_system()) < deadline:
        set finished to result_cache_scalar(db and "SELECT status FROM process_operations WHERE operation_id=2" and [])
        ep_dlcall1(ep_dlsym(native_system() and "usleep") and 10000)
    guard_assert(finished == "completed" and "supervisor survives launcher death and persists cleanup receipt")
    guard_assert(result_cache_scalar(db and "SELECT json_extract(result,'$.termination') FROM process_operations WHERE operation_id=2" and []) == "abandoned" and "parent death is reported as abandoned")
    guard_assert(ep_dlcall2(ep_dlsym(native_system() and "kill") and owned and 0) != 0 and "owned command killed and reaped")
    set deadline to transport_now(native_system()) + 3000
    repeat while ep_dlcall2(ep_dlsym(native_system() and "kill") and descendant and 0) == 0 && transport_now(native_system()) < deadline:
        ep_dlcall1(ep_dlsym(native_system() and "usleep") and 10000)
    guard_assert(ep_dlcall2(ep_dlsym(native_system() and "kill") and descendant and 0) != 0 and "same-group descendant stopped")
    set lock to private_lock(home and "state.lock")
    guard_assert(ep_dlcall2(ep_dlsym(native_system() and "flock") and lock and 6) == 0 and "state lease released after cleanup")
    ep_dlcall1(ep_dlsym(native_system() and "close") and lock)
    # Reopen exactly the receipts left by the real supervisor; the parent never
    # attached observations. A later turn must retrieve them without execution.
    sql_execute(db and "ALTER TABLE turns ADD COLUMN project TEXT DEFAULT 'restart-test'; ALTER TABLE tool_runs ADD COLUMN observation INTEGER; CREATE TABLE response_cache(key TEXT PRIMARY KEY,epoch TEXT,payload TEXT,digest TEXT,bytes INTEGER,used INTEGER); UPDATE turns SET status='abandoned'; INSERT INTO turns VALUES(2,'pending','restart-test'); INSERT INTO tool_runs VALUES(3,2,'process_output','1:stdout:0','running',NULL),(4,2,'process_output','2:stdout:0','running',NULL);")
    sql_close(db)
    set db to sql_open(database)
    set saved to process_output(db and "1:stdout:0" and "0" and "3")
    guard_assert(string_contains(saved and "ONCE-294 café") and "new turn reads actual saved output after database reopen")
    set cancelled to process_output(db and "2:stdout:0" and "0" and "4")
    guard_assert(result_cache_scalar(db and "SELECT json_extract(?,'$.original_exit_code')" and [cancelled]) == "137" and "new turn sees actual cancelled command exit")
    guard_assert(read_file(counter) == "1" && result_cache_scalar(db and "SELECT count(*) FROM process_operations" and []) == "2" and "reading recovered results does not replay either command")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " real native supervisor checks"))
    return 0
