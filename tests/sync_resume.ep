import "../src/sync_store"
import "os"
import "fs"
set checks to 0

define resume_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define resume_ok with db and result:
    set status to result_cache_scalar(db and "SELECT CASE WHEN json_valid(?) THEN coalesce(json_extract(?,'$.status'),'ok') ELSE 'error' END" and [result,result])
    if status == "error":
        display result
        return 0
    return 1

define main:
    set args to get_args()
    if length_list(args) != 3:
        display "Usage: sync_resume NEW_SENDER_DB NEW_RECEIVER_DB"
        return 1
    set sender_path to get_list(args and 1)
    set receiver_path to get_list(args and 2)
    if file_exists(sender_path) || file_exists(receiver_path):
        display "Use new isolated database files"
        return 1
    set sender to sql_open(sender_path)
    set receiver to sql_open(receiver_path)
    resume_assert(sync_store_init(sender) && sync_store_init(receiver) and "persistent stores initialized")
    set device to result_cache_scalar(sender and "SELECT value FROM sync_meta WHERE key='device'" and [])
    set n to 0
    repeat while n < 40:
        set object to result_cache_scalar(sender and "SELECT printf('%032x',CAST(? AS INTEGER)+100)" and [int_to_string(n)])
        set payload to result_cache_scalar(sender and "SELECT json_object('body','Retained record '||?)" and [int_to_string(n)])
        resume_assert(resume_ok(sender and sync_write(sender and object and "memory" and payload and sync_heads(sender and object))) and "persist local record")
        set n to n + 1
    set page to sync_export(sender and "0")
    resume_assert(result_cache_scalar(sender and "SELECT json_array_length(?,'$.records')" and [page]) == "16" and "first page bounded to sixteen changes")
    resume_assert(resume_ok(receiver and sync_import(receiver and device and page)) and "first page committed")
    sql_close(sender)
    sql_close(receiver)
    set sender to sql_open(sender_path)
    set receiver to sql_open(receiver_path)
    resume_assert(sync_store_init(sender) && sync_store_init(receiver) and "schema reopening preserves state")
    resume_assert(result_cache_scalar(sender and "SELECT value FROM sync_meta WHERE key='device'" and []) == device and "device identity persists across restart")
    resume_assert(result_cache_scalar(receiver and "SELECT cursor FROM sync_cursors WHERE peer=?" and [device]) == "16" and "resume cursor persists across restart")
    resume_assert(resume_ok(receiver and sync_import(receiver and device and page)) && result_cache_scalar(receiver and "SELECT count(*) FROM sync_versions" and []) == "16" and "lost acknowledgement replay is idempotent after restart")
    set rounds to 0
    set done to 0
    repeat while rounds < 10 && done == 0:
        set cursor to result_cache_scalar(receiver and "SELECT cursor FROM sync_cursors WHERE peer=?" and [device])
        set next to sync_export(sender and cursor)
        resume_assert(resume_ok(receiver and sync_import(receiver and device and next)) and "resumed page committed")
        set done to result_cache_scalar(receiver and "SELECT count(*)=40 FROM sync_objects" and []) == "1"
        set rounds to rounds + 1
    resume_assert(done && rounds == 2 and "all forty records transfer in bounded resumed pages")
    set source_rows to result_cache_scalar(sender and "SELECT json_group_array(json(row)) FROM (SELECT json_array(id,object,origin,sequence,clock,payload,digest) row FROM sync_versions ORDER BY id)" and [])
    set target_rows to result_cache_scalar(receiver and "SELECT json_group_array(json(row)) FROM (SELECT json_array(id,object,origin,sequence,clock,payload,digest) row FROM sync_versions ORDER BY id)" and [])
    resume_assert(string_equals(source_rows and target_rows) and "every retained byte and causal revision matches")
    resume_assert(resume_ok(sender and sync_export(sender and "41")) == 0 and "sender rollback or impossible cursor is reported")
    set complete to sync_export(sender and "40")
    resume_assert(result_cache_scalar(sender and "SELECT json_array_length(?,'$.records')" and [complete]) == "0" && resume_ok(receiver and sync_import(receiver and device and complete)) and "caught-up peer gets a stable empty page")
    sql_close(sender)
    sql_close(receiver)
    display concat("PASS: " and concat(int_to_string(checks) and " durable sync resume checks"))
    return 0
