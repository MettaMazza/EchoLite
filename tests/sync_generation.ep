import "../src/sync_generation"
import "os"
set checks to 0

define generation_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define generation_ok with db and result:
    set status to result_cache_scalar(db and "SELECT coalesce(json_extract(?,'$.status'),'ok')" and [result])
    if status == "error":
        return 0
    return 1

define main:
    set db to sql_open(":memory:")
    generation_assert(sql_execute(db and "PRAGMA foreign_keys=ON; CREATE TABLE memories(id INTEGER PRIMARY KEY AUTOINCREMENT,body TEXT); CREATE TABLE me_versions(id INTEGER PRIMARY KEY AUTOINCREMENT,body TEXT); CREATE TABLE turns(id INTEGER PRIMARY KEY AUTOINCREMENT); CREATE TABLE tool_runs(id INTEGER PRIMARY KEY AUTOINCREMENT); CREATE TABLE generation_rounds(turn_id INTEGER REFERENCES turns(id) ON DELETE CASCADE,round INTEGER,response TEXT,PRIMARY KEY(turn_id,round));") == 0 && sync_identity_init(db) && sync_generation_init(db) and "generation capture schema")
    generation_assert(sql_execute(db and "INSERT INTO turns DEFAULT VALUES; INSERT INTO generation_rounds SELECT 1,0,json_object('reasoning',replace(hex(zeroblob(40000)),'0','🌱'),'completion_tokens',2048);") == 0 and "large Unicode thinking fixture")
    set original to result_cache_scalar(db and "SELECT response FROM generation_rounds" and [])
    sql_execute(db and "CREATE TRIGGER injected_chunk_failure BEFORE INSERT ON sync_generation_parts WHEN new.ordinal=1 BEGIN SELECT RAISE(ABORT,'injected chunk write failure'); END;")
    generation_assert(generation_ok(db and sync_generation_capture(db and "1" and "0")) == 0 and "mid-capture storage failure is reported")
    generation_assert(result_cache_scalar(db and "SELECT count(*) FROM sync_versions" and []) == "0" && result_cache_scalar(db and "SELECT count(*) FROM sync_generation_parts" and []) == "0" && result_cache_scalar(db and "SELECT dirty FROM sync_generation_rows" and []) == "1" and "failed capture rolls back partial chunks and keeps retry queued")
    sql_execute(db and "DROP TRIGGER injected_chunk_failure")
    set captured to sync_generation_capture(db and "1" and "0")
    generation_assert(generation_ok(db and captured) and concat("chunked thinking capture: " and captured))
    set owner to result_cache_scalar(db and "SELECT object FROM sync_generation_rows" and [])
    generation_assert(result_cache_scalar(db and "SELECT count(*)>1 FROM sync_generation_parts WHERE owner=?" and [owner]) == "1" and "response spans multiple bounded chunks")
    generation_assert(result_cache_scalar(db and "SELECT max(length(CAST(payload AS BLOB)))<=65536 FROM sync_versions" and []) == "1" and "every revision fits transport record bound")
    set assembled to result_cache_scalar(db and "SELECT group_concat(data,'') FROM (SELECT json_extract(v.payload,'$.data') data FROM sync_generation_parts p JOIN sync_versions v ON v.object=p.object WHERE p.owner=? ORDER BY p.ordinal)" and [owner])
    generation_assert(string_equals(original and assembled) && sha256(original) == sha256(assembled) and "UTF-8 chunks reconstruct exact original bytes")
    set sequence to result_cache_scalar(db and "SELECT value FROM sync_meta WHERE key='sequence'" and [])
    generation_assert(generation_ok(db and sync_generation_capture(db and "1" and "0")) && result_cache_scalar(db and "SELECT value FROM sync_meta WHERE key='sequence'" and []) == sequence and "persistent capture avoids duplicate work")
    sql_execute(db and "BEGIN; DELETE FROM generation_rounds; ROLLBACK;")
    generation_assert(result_cache_scalar(db and "SELECT count(*) FROM sync_objects WHERE deleted=1" and []) == "0" && result_cache_scalar(db and "SELECT response FROM generation_rounds" and []) == original and "rolled back forgetting retains complete original state")
    sql_execute(db and "DELETE FROM generation_rounds")
    generation_assert(result_cache_scalar(db and "SELECT count(*) FROM sync_versions" and []) == "0" && result_cache_scalar(db and "SELECT count(*) FROM sync_seen" and []) == "0" and "forgetting removes queued thinking and content hashes")
    generation_assert(result_cache_scalar(db and "SELECT count(*) FROM sync_objects WHERE deleted=0" and []) == "0" && result_cache_scalar(db and "SELECT count(*) FROM sync_generation_parts" and []) == "0" and "manifest and all owned chunks become tombstones")
    generation_assert(string_contains(sync_export(db and "0") and "reasoning") == 0 and "old transfer cursor cannot replay forgotten text")
    sql_execute(db and "INSERT INTO generation_rounds VALUES(1,0,'{\"reasoning\":\"New result\"}')")
    generation_assert(result_cache_scalar(db and "SELECT object FROM sync_generation_rows" and []) != owner && generation_ok(db and sync_generation_capture(db and "1" and "0")) and "new generation uses fresh identity after forgetting")
    sql_execute(db and "DELETE FROM turns WHERE id=1")
    generation_assert(result_cache_scalar(db and "SELECT count(*) FROM sync_versions" and []) == "0" && result_cache_scalar(db and "SELECT count(*) FROM sync_generation_rows" and []) == "0" and "turn cascade purges queued generation data")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " bounded thinking capture checks"))
    return 0
