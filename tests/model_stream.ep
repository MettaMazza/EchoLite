import "../src/model_stream"
import "os"
set checks to 0

define assert_stream with passed and label:
    if passed == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define main:
    set db to sql_open(":memory:")
    set source to ": heartbeat\r\n\r\ndata: {\"choices\":[{\"delta\":{\"reasoning_content\":\"Consider 🌱.\"}}]}\r\n\r\ndata: {\"choices\":[{\"delta\":{\"content\":\"Ready.\"},\"finish_reason\":\"stop\"}]}\r\n\r\ndata: {\"choices\":[],\"usage\":{\"prompt_tokens\":17,\"completion_tokens\":8,\"completion_tokens_details\":{\"reasoning_tokens\":5}}}\r\n\r\ndata: [DONE]\r\n\r\n"
    set width to 1
    repeat while width <= 17:
        set state to model_stream()
        set i to 0
        repeat while i < string_length(source):
            set count to width
            if i + count > string_length(source):
                set count to string_length(source) - i
            model_stream_feed(db and state and substring(source and i and count) and 0)
            set i to i + count
        assert_stream(model_stream_feed(db and state and "" and 1) and "fragmented SSE complete")
        assert_stream(get_list(state and 1) == "Ready." and "answer separated")
        assert_stream(get_list(state and 2) == "Consider 🌱." and "thinking and UTF-8 preserved")
        assert_stream(get_list(state and 4) == "17" && get_list(state and 5) == "8" && get_list(state and 8) == "5" and "actual usage preserved")
        set width to width + 4
    set state to model_stream()
    model_stream_feed(db and state and "data: {bad}\n\n" and 1)
    assert_stream(get_list(state and 7) != "" and "malformed JSON rejected")
    set state to model_stream()
    model_stream_feed(db and state and "data: {\"choices\":[{\"delta\":{\"content\":123}}]}\n\n" and 1)
    assert_stream(get_list(state and 7) != "" and "invalid content type rejected")
    set state to model_stream()
    model_stream_feed(db and state and "data: {\"error\":{\"message\":\"bad\"}}\n\n" and 1)
    assert_stream(get_list(state and 7) != "" and "runtime error rejected")
    set state to model_stream()
    model_stream_feed(db and state and "data: {\"choices\":[{\"delta\":{\"content\":\"partial\"}}]}\n\n" and 1)
    assert_stream(get_list(state and 7) != "" and "missing DONE rejected")
    set state to model_stream()
    model_stream_feed(db and state and "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"length\"}]}\n\ndata: [DONE]\n\n" and 1)
    set result to model_stream_result(db and state)
    assert_stream(string_contains(result and "truncated") and "token limit retained")
    assert_stream(string_contains(result and "\"reasoning_tokens\":null") and "unknown thinking count not invented")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " model stream checks in Ernos Plain"))
    return 0
