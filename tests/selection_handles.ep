import "../src/chat_editor"
import "os"
set checks to 0

define handle_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define main:
    handle_assert(editor_menu_touch_y(300 and 340 and 800) == 240 and "toolbar above text with clear handle targets")
    handle_assert(editor_menu_touch_y(40 and 80 and 800) == 108 and "toolbar below selection near top edge")
    handle_assert(editor_menu_touch_y(10 and 780 and 800) == -1 and "hide toolbar when no unobstructed space")
    set points to [[100,100],[140,100]]
    handle_assert(editor_handle_pick(points and 94 and 108 and 0 and 200) == 1 and "start handle has a generous touch target")
    handle_assert(editor_handle_pick(points and 138 and 110 and 0 and 200) == 2 and "nearest end handle selected")
    handle_assert(editor_handle_pick(points and 250 and 100 and 0 and 200) == 0 && editor_handle_pick(points and 100 and 100 and 120 and 200) == 0 and "outside and clipped handles ignored")
    set EDIT_TEXT to "abc🌱def"
    set EDIT_ANCHOR to 0
    set EDIT_CARET to 7
    set HANDLE_SINGLE to 0
    editor_handle_move(1 and 1 and 2)
    handle_assert(EDIT_ANCHOR == 2 && EDIT_CARET == 7 && EDIT_FOCUS == 1 and "moving start preserves end and keyboard focus")
    editor_handle_move(1 and 2 and 5)
    handle_assert(EDIT_CARET == 3 and "drag cannot split Unicode codepoint")
    editor_handle_move(1 and 2 and 2)
    editor_handle_move(1 and 2 and 1)
    handle_assert(EDIT_ANCHOR == 2 && EDIT_CARET == 1 and "end handle crosses start without collapsing its anchor")
    set HANDLE_SINGLE to 1
    editor_handle_move(1 and 2 and 8)
    handle_assert(EDIT_ANCHOR == 8 && EDIT_CARET == 8 and "single insertion handle moves both offsets")
    set SELECT_TEXT to "hello world"
    set SELECT_ANCHOR to 0
    set SELECT_CARET to 5
    editor_handle_move(2 and 2 and 11)
    handle_assert(editor_selected(SELECT_TEXT and SELECT_CARET and SELECT_ANCHOR) == "hello world" and "read-only selection extends for copying")
    display concat("PASS: " and concat(int_to_string(checks) and " selection handle checks"))
    return 0
