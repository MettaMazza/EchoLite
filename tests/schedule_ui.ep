import "os"
import "../src/ui_schedule"
set checks to 0

define idle_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define main:
    idle_assert(ui_schedule_ready(70000 and 60000 and 0 and 0 and 1 and "" and "") and "idle task eligible at boundary")
    idle_assert(ui_schedule_ready(69999 and 60000 and 0 and 0 and 1 and "" and "") == 0 and "recent activity blocks dispatch")
    idle_assert(ui_schedule_ready(70000 and 0 and 10001 and 0 and 1 and "" and "") == 0 and "retry backoff enforced")
    idle_assert(ui_schedule_ready(70000 and 0 and 0 and 1 and 1 and "" and "") == 0 and "busy UI blocks dispatch")
    idle_assert(ui_schedule_ready(70000 and 0 and 0 and 0 and 0 and "" and "") == 0 and "model startup blocks dispatch")
    idle_assert(ui_schedule_ready(70000 and 0 and 0 and 0 and 1 and "draft" and "") == 0 and "unsent draft blocks dispatch")
    idle_assert(ui_schedule_ready(70000 and 0 and 0 and 0 and 1 and "" and "image") == 0 and "attachment blocks dispatch")
    set db to sql_open(":memory:")
    sql_execute(db and "CREATE TABLE tasks(memory INTEGER,project TEXT,current_memory INTEGER,status TEXT); CREATE TABLE memories(id INTEGER,body TEXT); CREATE TABLE task_schedules(memory INTEGER,task INTEGER,status TEXT,due_at INTEGER,turn_id INTEGER); CREATE TABLE turns(id INTEGER,status TEXT); INSERT INTO tasks VALUES(1,'p',2,'planned'),(3,'foreign',4,'planned'); INSERT INTO memories VALUES(2,'{\"objective\":\"Calculate 47*19\"}'),(4,'{\"objective\":\"Private foreign task\"}'); INSERT INTO task_schedules VALUES(5,1,'cancelled',0,NULL),(6,1,'armed',1700000000,NULL);")
    set rows to ui_schedule_rows(db and "p")
    idle_assert(length_list(rows) == 1 and "task view isolates the active project")
    set row to get_list(rows and 0)
    idle_assert(get_list(row and 0) == "6" && get_list(row and 2) == "armed" and "latest schedule replaces historical display")
    idle_assert(get_list(row and 4) == "Calculate 47*19" and "saved objective displayed")
    idle_assert(string_contains(get_list(row and 3) and "UTC") and "due time is explicitly UTC")
    sql_execute(db and "UPDATE task_schedules SET status='dispatched',turn_id=7 WHERE memory=6; INSERT INTO turns VALUES(7,'failed');")
    set row to get_list(ui_schedule_rows(db and "p") and 0)
    idle_assert(get_list(row and 7) == "failed" && get_list(row and 5) == "planned" and "failed turn remains distinct from task success")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " idle scheduling and task display checks"))
    return 0
