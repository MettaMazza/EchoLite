import "../src/pdf_tool"
import "pdf_fixture"
set checks to 0

define pdf_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define pdf_test_request with db and path and page and offset returning Str:
    set params to [path,int_to_string(page),int_to_string(offset)]
    return result_cache_scalar(db and "SELECT json_object('path',?,'page',CAST(? AS INTEGER),'offset',CAST(? AS INTEGER))" and params)

define main:
    set args to get_args()
    if length_list(args) != 3:
        return 1
    set root to get_list(args and 1)
    set helper to get_list(args and 2)
    set path to concat(root and "/reference café.pdf")
    pdf_fixture(path)
    set database to concat(root and "/cache.sqlite3")
    set db to sql_open(database)
    pdf_assert(sql_execute(db and "CREATE TABLE metadata(key TEXT PRIMARY KEY,value TEXT); INSERT INTO metadata VALUES('cache_epoch','0'); CREATE TABLE response_cache(key TEXT PRIMARY KEY,epoch TEXT,payload TEXT,digest TEXT,bytes INTEGER,used INTEGER);") == 0 and "isolated cache")
    set request to pdf_test_request(db and path and 1 and 0)
    set result to pdf_lookup(db and helper and request and "0")
    pdf_assert(string_contains(result and "ALDER-527") and concat("actual PDF text: " and result))
    pdf_assert(string_contains(result and "Café au lait") and "native Unicode extraction")
    pdf_assert(result_cache_scalar(db and "SELECT json_extract(?,'$.pages')" and [result]) == "3" and "page count")
    pdf_assert(result_cache_scalar(db and "SELECT json_extract(?,'$.child_peak_rss_bytes') BETWEEN 1 AND 268435456" and [result]) == "1" and "child measured resident high-water mark")
    pdf_assert(string_contains(result and "#page=1") and "page citation")
    pdf_assert(result_cache_scalar(db and "SELECT json_extract(?,'$.cache_hit')" and [result]) == "0" and "initial extraction")
    sql_close(db)
    set db to sql_open(database)
    set result to pdf_lookup(db and "/missing-helper-proves-cache" and request and "0")
    pdf_assert(result_cache_scalar(db and "SELECT json_extract(?,'$.cache_hit')" and [result]) == "1" and "persistent cache replay without helper")
    set result to pdf_lookup(db and helper and pdf_test_request(db and path and 2 and 0) and "0")
    set next to result_cache_scalar(db and "SELECT json_extract(?,'$.next_offset')" and [result])
    pdf_assert(string_to_int(next) > 0 and concat("long page continuation: " and result))
    set following to pdf_lookup(db and "/missing-helper-proves-cache" and pdf_test_request(db and path and 2 and string_to_int(next)) and "0")
    pdf_assert(result_cache_scalar(db and "SELECT json_extract(?,'$.offset')" and [following]) == next and "cached page continuation")
    set result to pdf_lookup(db and helper and pdf_test_request(db and path and 3 and 0) and "0")
    pdf_assert(string_contains(result and "no_extractable_text") and "blank page disclosed without invented text")
    set result to pdf_lookup(db and helper and pdf_test_request(db and path and 4 and 0) and "0")
    pdf_assert(string_contains(result and "beyond") and "page range rejected")
    set result to pdf_lookup(db and helper and pdf_test_request(db and path and 1 and 20000) and "0")
    pdf_assert(string_contains(result and "offset is beyond") and "invalid continuation rejected")
    pdf_assert(string_contains(pdf_lookup(db and helper and "{\"path\":\"relative.pdf\",\"page\":1,\"offset\":0}" and "0") and "absolute") and "relative paths rejected")
    write_file(path and "not a PDF")
    pdf_assert(string_contains(pdf_lookup(db and "/missing-helper-proves-invalidation" and request and "0") and "Cannot start") and "changed file does not reuse cached page")
    sql_execute(db and "UPDATE metadata SET value='1'")
    pdf_fixture(path)
    pdf_assert(string_contains(pdf_lookup(db and helper and request and "0") and "error") and "forgotten epoch rejected")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " native EP PDF checks"))
    return 0
