# Emits a test-only instrumentation runner. Run against the installed APK with
# am instrument -w dev.echolite.imecheck/org.libsdl.app.KeyboardChecks.
import "../src/android/jvm_class"
set CHECK_OWNER to "org/libsdl/app/KeyboardChecks"
set IC to "android/view/inputmethod/InputConnection"

define ime_commit with word:
    jvm_emit([43])
    jvm_string(word)
    jvm_emit([4])
    jvm_interface(IC and "commitText" and "(Ljava/lang/CharSequence;I)Z" and 3)
    return jvm_emit([87])

define ime_compose with word:
    jvm_emit([43])
    jvm_string(word)
    jvm_emit([4])
    jvm_interface(IC and "setComposingText" and "(Ljava/lang/CharSequence;I)Z" and 3)
    return jvm_emit([87])

define ime_batch with method:
    jvm_emit([43])
    jvm_interface(IC and method and "()Z" and 1)
    return jvm_emit([87])

define ime_delete with method and number:
    jvm_emit([43])
    jvm_int(number)
    jvm_emit([3])
    jvm_interface(IC and method and "(II)Z" and 3)
    return jvm_branch(153 and "failed")

define ime_expect with expected and step:
    jvm_emit([42])
    jvm_string(step)
    jvm_access(181 and CHECK_OWNER and "result" and "Ljava/lang/String;")
    jvm_emit([43])
    jvm_int(128)
    jvm_emit([3])
    jvm_interface(IC and "getTextBeforeCursor" and "(II)Ljava/lang/CharSequence;" and 3)
    jvm_call(182 and "java/lang/Object" and "toString" and "()Ljava/lang/String;")
    jvm_string(expected)
    jvm_call(182 and "java/lang/String" and "equals" and "(Ljava/lang/Object;)Z")
    return jvm_branch(153 and "failed")

define main:
    set args to get_args()
    if length_list(args) != 2:
        return 1
    set inst to "android/app/Instrumentation"
    jvm_begin(CHECK_OWNER and inst and ["java/lang/Runnable"])
    jvm_field("result" and "Ljava/lang/String;")
    jvm_constructor()
    jvm_method()
    jvm_emit([42])
    jvm_call(182 and inst and "start" and "()V")
    jvm_emit([177])
    jvm_end(1 and "onCreate" and "(Landroid/os/Bundle;)V" and 1 and 2 and [])

    jvm_method()
    jvm_emit([42,42])
    jvm_call(182 and inst and "getTargetContext" and "()Landroid/content/Context;")
    jvm_call(182 and "android/content/Context" and "getPackageManager" and "()Landroid/content/pm/PackageManager;")
    jvm_string("dev.echolite.android")
    jvm_call(182 and "android/content/pm/PackageManager" and "getLaunchIntentForPackage" and "(Ljava/lang/String;)Landroid/content/Intent;")
    jvm_call(182 and inst and "startActivitySync" and "(Landroid/content/Intent;)Landroid/app/Activity;")
    jvm_emit([87,42,42])
    jvm_call(182 and inst and "runOnMainSync" and "(Ljava/lang/Runnable;)V")
    jvm_new("android/os/Bundle")
    jvm_emit([89])
    jvm_call(183 and "android/os/Bundle" and "<init>" and "()V")
    jvm_emit([76,43])
    jvm_string("keyboard")
    jvm_emit([42])
    jvm_access(180 and CHECK_OWNER and "result" and "Ljava/lang/String;")
    jvm_call(182 and "android/os/Bundle" and "putString" and "(Ljava/lang/String;Ljava/lang/String;)V")
    jvm_emit([42])
    jvm_string("PASS")
    jvm_emit([42])
    jvm_access(180 and CHECK_OWNER and "result" and "Ljava/lang/String;")
    jvm_call(182 and "java/lang/String" and "equals" and "(Ljava/lang/Object;)Z")
    jvm_emit([116,43])
    jvm_call(182 and inst and "finish" and "(ILandroid/os/Bundle;)V")
    jvm_emit([177])
    jvm_end(1 and "onStart" and "()V" and 3 and 2 and [])

    jvm_method()
    jvm_new("org/libsdl/app/SDLDummyEdit")
    jvm_emit([89])
    jvm_call(184 and "org/libsdl/app/SDL" and "getContext" and "()Landroid/app/Activity;")
    jvm_call(183 and "org/libsdl/app/SDLDummyEdit" and "<init>" and "(Landroid/content/Context;)V")
    jvm_new("android/view/inputmethod/EditorInfo")
    jvm_emit([89])
    jvm_call(183 and "android/view/inputmethod/EditorInfo" and "<init>" and "()V")
    jvm_call(182 and "android/view/View" and "onCreateInputConnection" and "(Landroid/view/inputmethod/EditorInfo;)Landroid/view/inputmethod/InputConnection;")
    jvm_emit([76])
    ime_batch("beginBatchEdit")
    ime_compose("he")
    ime_compose("hel")
    ime_commit("hello")
    # Nothing intermediate should have been delivered to the native draft.
    jvm_emit([42])
    jvm_string("FAIL: suggestion replacement published before end of batch")
    jvm_access(181 and CHECK_OWNER and "result" and "Ljava/lang/String;")
    jvm_emit([43])
    jvm_index(192 and jvm_class("org/libsdl/app/SDLInputConnection"))
    jvm_access(180 and "org/libsdl/app/SDLInputConnection" and "mCommittedText" and "Ljava/lang/String;")
    jvm_call(182 and "java/lang/String" and "isEmpty" and "()Z")
    jvm_branch(153 and "failed")
    ime_batch("endBatchEdit")
    ime_expect("hello" and "FAIL: completion")
    ime_delete("deleteSurroundingText" and 2)
    ime_compose("p")
    ime_commit("ping")
    ime_expect("helping" and "FAIL: delete then select second completion")
    ime_delete("deleteSurroundingText" and 3)
    ime_commit("er")
    ime_delete("deleteSurroundingText" and 1)
    ime_expect("helpe" and "FAIL: delete, retype and delete again")
    ime_delete("deleteSurroundingText" and 5)
    ime_commit("cat")
    ime_delete("deleteSurroundingText" and 1)
    ime_expect("ca" and "FAIL: UTF-16 backspace left a stale composing buffer")
    ime_commit("r")
    ime_expect("car" and "FAIL: retyping after deletion")
    jvm_emit([43])
    jvm_int(127793)
    jvm_call(184 and "java/lang/Character" and "toChars" and "(I)[C")
    jvm_call(184 and "java/lang/String" and "valueOf" and "([C)Ljava/lang/String;")
    jvm_emit([4])
    jvm_interface(IC and "commitText" and "(Ljava/lang/CharSequence;I)Z" and 3)
    jvm_emit([87])
    ime_delete("deleteSurroundingText" and 2)
    ime_expect("car" and "FAIL: emoji backspace")
    ime_delete("deleteSurroundingTextInCodePoints" and 2)
    ime_expect("c" and "FAIL: code-point delete")
    jvm_emit([43])
    jvm_index(192 and jvm_class("org/libsdl/app/SDLInputConnection"))
    jvm_access(180 and "org/libsdl/app/SDLInputConnection" and "mCommittedText" and "Ljava/lang/String;")
    jvm_string("c")
    jvm_call(182 and "java/lang/String" and "equals" and "(Ljava/lang/Object;)Z")
    jvm_branch(153 and "failed")
    ime_delete("deleteSurroundingText" and 8)
    ime_expect("" and "FAIL: delete across a restarted connection")
    ime_commit("fresh")
    ime_expect("fresh" and "FAIL: deleted text returned")
    ime_delete("deleteSurroundingText" and 5)
    ime_commit("end")
    jvm_emit([43,3,3])
    jvm_interface(IC and "setSelection" and "(II)Z" and 3)
    jvm_emit([87])
    ime_batch("beginBatchEdit")
    ime_compose("ca")
    ime_commit("can ")
    ime_batch("endBatchEdit")
    ime_delete("deleteSurroundingText" and 1)
    ime_delete("deleteSurroundingText" and 1)
    ime_compose("t")
    ime_commit("r")
    ime_delete("deleteSurroundingText" and 1)
    ime_expect("ca" and "FAIL: completion and repeated edits before suffix")
    jvm_emit([42])
    jvm_string("FAIL: suffix corrupted by IME correction")
    jvm_access(181 and CHECK_OWNER and "result" and "Ljava/lang/String;")
    jvm_emit([43])
    jvm_int(128)
    jvm_emit([3])
    jvm_interface(IC and "getTextAfterCursor" and "(II)Ljava/lang/CharSequence;" and 3)
    jvm_call(182 and "java/lang/Object" and "toString" and "()Ljava/lang/String;")
    jvm_string("end")
    jvm_call(182 and "java/lang/String" and "equals" and "(Ljava/lang/Object;)Z")
    jvm_branch(153 and "failed")
    jvm_emit([42])
    jvm_string("PASS")
    jvm_access(181 and CHECK_OWNER and "result" and "Ljava/lang/String;")
    jvm_label("failed")
    jvm_emit([177])
    jvm_end(1 and "run" and "()V" and 4 and 2 and [])
    return jvm_write(get_list(args and 1))
