# Validate the completed offline native UI journey, without calling the model.
import "../src/result_cache"
import "../src/network_policy"
set checks to 0

define journey_assert with valid and label:
    if valid == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define main:
    set args to get_args()
    if length_list(args) != 2:
        return 1
    set home to get_list(args and 1)
    set_env("ECHOLITE_NETWORK_MODE" and "")
    journey_assert(network_mode(home) == "automatic" and "legacy offline journey remains readable with automatic connectivity")
    set db to sql_open(concat(home and "/memory.sqlite3"))
    journey_assert(result_cache_scalar(db and "SELECT count(*) FROM turns WHERE status='completed'" and []) == "2" and "both actual model turns completed")
    journey_assert(result_cache_scalar(db and "SELECT count(*) FROM tool_runs WHERE turn_id=1 AND name IN ('dictionary','calculator') AND status='completed'" and []) == "2" and "local dictionary and calculation chained offline")
    journey_assert(result_cache_scalar(db and "SELECT count(*) FROM turns t JOIN memories m ON m.id=t.reply_memory WHERE t.id=1 AND instr(m.body,'731')>0 AND instr(m.body,'photosynthesis')>0" and []) == "1" and "answer contains both verified results")
    journey_assert(result_cache_scalar(db and "SELECT count(*) FROM process_operations WHERE status='completed' AND json_extract(result,'$.exit_code')=0" and []) == "1" and "model-selected sandbox diagnostic completed with zero exit status")
    journey_assert(result_cache_scalar(db and "SELECT count(*) FROM turns t JOIN memories m ON m.id=t.reply_memory WHERE t.id=2 AND t.answer_basis='execution' AND instr(m.body,'EPERM')>0" and []) == "1" and "final execution answer reports the actual network denial")
    journey_assert(result_cache_scalar(db and "SELECT count(*)>0 FROM ep_memory_vectors" and []) == "1" and "local embedding recall retained vectors")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " actual offline UI journey checks"))
    return 0
