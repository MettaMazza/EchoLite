# Posts keyboard input only to the explicitly supplied EchoLite test-window PID.
import "../src/native_process"
import "string"
import "os"

define main:
    set args to get_args()
    if length_list(args) != 3:
        return 1
    set cg to ep_dlopen("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
    if ep_dlcall0(ep_dlsym(cg and "CGPreflightPostEventAccess")) == 0:
        display "Native event posting is not authorized"
        return 2
    set pid to string_to_int(get_list(args and 1))
    set text to get_list(args and 2)
    set utf16 to alloc_bytes((string_length(text) + 1) * 2)
    set i to 0
    repeat while i < string_length(text):
        native_bytes_write(utf16 and i * 2 and get_character(text and i) and 2)
        set i to i + 1
    set event to ep_dlcall3(ep_dlsym(cg and "CGEventCreateKeyboardEvent") and 0 and 0 and 1)
    ep_dlcall3(ep_dlsym(cg and "CGEventKeyboardSetUnicodeString") and event and string_length(text) and utf16)
    ep_dlcall2(ep_dlsym(cg and "CGEventPostToPid") and pid and event)
    ep_dlcall1(ep_dlsym(cg and "CFRelease") and event)
    ep_dlcall1(ep_dlsym(native_system() and "usleep") and 200000)
    set event to ep_dlcall3(ep_dlsym(cg and "CGEventCreateKeyboardEvent") and 0 and 36 and 1)
    ep_dlcall2(ep_dlsym(cg and "CGEventPostToPid") and pid and event)
    ep_dlcall1(ep_dlsym(cg and "CFRelease") and event)
    set event to ep_dlcall3(ep_dlsym(cg and "CGEventCreateKeyboardEvent") and 0 and 36 and 0)
    ep_dlcall2(ep_dlsym(cg and "CGEventPostToPid") and pid and event)
    ep_dlcall1(ep_dlsym(cg and "CFRelease") and event)
    free_bytes(utf16)
    display "Posted text and Enter to the selected EchoLite window"
    return 0
