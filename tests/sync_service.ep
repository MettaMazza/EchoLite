# Isolated actual-schema network harness, never pointed at personal state.
import "../src/sync_service"
import "../src/sync_startup"

define main:
    set args to get_args()
    if length_list(args) < 3:
        return 1
    set command to get_list(args and 1)
    set home to get_list(args and 2)
    set leased to sync_command_lease(home and "maintenance" and home and "" and 18997)
    if string_contains(leased and "\"status\":\"ok\"") == 0:
        display leased
        return 1
    set db to sql_open(concat(home and "/memory.sqlite3"))
    sql_execute(db and "PRAGMA foreign_keys=ON")
    if sync_pair_init(db) == 0 || sync_coordinator_init(db) == 0:
        return 1
    set result to "{\"status\":\"ok\"}"
    if command == "init":
        display result_cache_scalar(db and "SELECT value FROM sync_meta WHERE key='device'" and [])
    else if command == "pair" && length_list(args) == 5:
        set result to sync_pair_install(db and get_list(args and 3) and "Fixture peer" and string_trim(read_file(get_list(args and 4))))
    else if command == "seed" && length_list(args) == 4:
        if sql_execute_params(db and "INSERT INTO memories(layer,project,source,body) VALUES('episodic','network','user',?)" and [get_list(args and 3)]) != 101:
            return 1
    else if command == "serve" && length_list(args) == 5:
        set listener to sync_socket_open(get_list(args and 3) and string_to_int(get_list(args and 4)) and 1)
        if listener < 0:
            return 1
        display "READY: application sync listener"
        set fd to sync_socket_accept(listener and transport_now(native_system()) + 60000)
        if fd < 0:
            sync_socket_close(listener)
            return 1
        set result to sync_service_receive(db and fd and home and home and "" and 18997)
        sync_socket_close(fd)
        sync_socket_close(listener)
    else if command == "exchange" && length_list(args) == 6:
        set result to sync_service_exchange(db and get_list(args and 3) and get_list(args and 4) and string_to_int(get_list(args and 5)) and home and home and "" and 18997)
    else if command == "inspect":
        set result to result_cache_scalar(db and "SELECT json_object('status','ok','memories',json((SELECT json_group_array(body) FROM (SELECT body FROM memories ORDER BY body))),'pending_cleanup',(SELECT count(*) FROM sync_cleanup),'deferred',(SELECT count(*) FROM sync_work WHERE issue!=''))" and [])
    else if command == "forget" && length_list(args) == 4:
        set object to result_cache_scalar(db and "SELECT i.object FROM memories m JOIN sync_local_ids i ON i.kind='memory' AND i.local_id=m.id WHERE m.body=?" and [get_list(args and 3)])
        set result to sync_forget(db and object)
        set result to sync_apply_memory_tombstone(db and object)
        set result to sync_cleanup_finish(db and home and home and "" and 18997)
    else:
        return 1
    display result
    set success to result_cache_scalar(db and "SELECT json_extract(?,'$.status')" and [result]) == "ok"
    sql_close(db)
    if success == 0:
        return 1
    return 0
