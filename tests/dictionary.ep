import "../src/dictionary"
set checks to 0

define assert_dictionary with passed and label:
    if passed == 0:
        display concat("FAIL: " and label)
        ep_exit(1)
    set checks to checks + 1
    return 0

define main:
    set args to get_args()
    if length_list(args) != 3:
        display "Usage: dictionary <library> <new cache database>"
        return 1
    assert_dictionary(dictionary_normalize("  ＲＥＳＩＬＩＥＮＣＥ  ") == "resilience" and "Unicode NFKC and case folding")
    assert_dictionary(dictionary_normalize("Straße") == "strasse" and "full Unicode case folding")
    assert_dictionary(dictionary_normalize("CAFÉ") == "café" and "accents retained")
    assert_dictionary(dictionary_quote("café word") == "caf%C3%A9%20word" and "source URL encoding")
    assert_dictionary(dictionary_excerpt("a🌱b" and 3) == "a" and "excerpt respects UTF-8 boundaries")
    set db to sql_open(get_list(args and 2))
    assert_dictionary(sql_execute(db and "CREATE TABLE metadata(key TEXT PRIMARY KEY,value TEXT); INSERT INTO metadata VALUES('cache_epoch','0'); CREATE TABLE response_cache(key TEXT PRIMARY KEY,epoch TEXT,payload TEXT,digest TEXT,bytes INTEGER,used INTEGER);") == 0 and "cache fixture initialized")
    set library to get_list(args and 1)
    set result to dictionary_lookup(db and library and "resilience" and "0")
    assert_dictionary(result_cache_scalar(db and "SELECT json_extract(?,'$.outcome')" and [result]) == "completed" and concat("actual offline definition: " and result))
    assert_dictionary(result_cache_scalar(db and "SELECT json_array_length(?,'$.entries') BETWEEN 1 AND 6" and [result]) == "1" and "bounded dictionary entries")
    assert_dictionary(string_contains(result and "Wiktionary contributors") && string_contains(result and "CC BY-SA") && string_contains(result and "https://en.wiktionary.org/wiki/") and "source and license preserved")
    assert_dictionary(result_cache_scalar(db and "SELECT count(*) FROM response_cache" and []) == "1" and "persistent tool result stored")
    sql_close(db)
    set db to sql_open(get_list(args and 2))
    set replay to dictionary_lookup(db and library and "ＲＥＳＩＬＩＥＮＣＥ" and "0")
    assert_dictionary(string_equals(result and replay) and "normalized lookup reuses exact result after reopen")
    assert_dictionary(result_cache_scalar(db and "SELECT count(*) FROM response_cache" and []) == "1" and "normalization shares cache entry")
    set missing to dictionary_lookup(db and library and "zzzxxyynonexistentwordecholite" and "0")
    assert_dictionary(string_contains(missing and "coverage gap") and "missing entry disclosure")
    set unavailable to dictionary_lookup(db and "/private/tmp/echolite-no-dictionary-installed" and "word" and "0")
    assert_dictionary(string_contains(unavailable and "unavailable") and "missing dictionary reported")
    assert_dictionary(string_contains(dictionary_lookup(db and library and "   " and "0") and "Invalid dictionary query") and "empty lookup rejected")
    sql_execute(db and "UPDATE metadata SET value='1'")
    assert_dictionary(string_contains(dictionary_lookup(db and library and "resilience" and "0") and "forgetting") and "stale cache epoch refused")
    sql_close(db)
    display concat("PASS: " and concat(int_to_string(checks) and " local dictionary checks in Ernos Plain"))
    return 0
