# Durable image attachments: small searchable memory records plus separate pixels.
import "pdf_tool"

define image_schema with db:
    return sql_execute(db and "CREATE TABLE IF NOT EXISTS image_assets(memory INTEGER PRIMARY KEY REFERENCES memories(id) ON DELETE CASCADE,project TEXT NOT NULL,path TEXT NOT NULL,source_sha256 TEXT NOT NULL,image_sha256 TEXT NOT NULL,width INTEGER NOT NULL,height INTEGER NOT NULL,bytes INTEGER NOT NULL,data_url TEXT NOT NULL,payload_sha256 TEXT NOT NULL); CREATE INDEX IF NOT EXISTS image_assets_project ON image_assets(project,memory)")

define image_capture with db and helper and path and epoch returning Str:
    if starts_with(path and "/") == 0 || string_length(path) > 4096:
        return pdf_error(db and "Image attachment requires an absolute local path")
    set snapshot to pdf_snapshot(db and path)
    if get_list(snapshot and 0) == 0:
        return pdf_error(db and string_replace(get_list(snapshot and 3) and "PDF" and "Image"))
    free_bytes(get_list(snapshot and 0))
    set digest to get_list(snapshot and 2)
    set namespace to concat("image-normalize-v1:" and pdf_cache_namespace())
    set captured to result_cache_get(db and namespace and digest and epoch)
    if captured == "":
        set captured to document_child(db and helper and path and 0 and 1048576)
        if result_cache_scalar(db and "SELECT json_extract(?,'$.status')" and [captured]) != "ok":
            return captured
        if string_equals(result_cache_scalar(db and "SELECT json_extract(?,'$.source_sha256')" and [captured]) and digest) == 0:
            return pdf_error(db and "Image changed while being imported; select it again")
        set captured to result_cache_scalar(db and "SELECT json_set(?,'$.text','Normalized local image attachment.')" and [captured])
        set captured to result_cache_put(db and namespace and digest and epoch and captured)
    return captured

define image_import with db and helper and project and path and epoch returning Str:
    if project == "" || string_length(project) > 256:
        return pdf_error(db and "Image attachment requires a project")
    set captured to image_capture(db and helper and path and epoch)
    if result_cache_scalar(db and "SELECT json_extract(?,'$.status')" and [captured]) != "ok":
        return captured
    set source to result_cache_scalar(db and "SELECT json_extract(?,'$.source_sha256')" and [captured])
    set digest to result_cache_scalar(db and "SELECT json_extract(?,'$.image_sha256')" and [captured])
    set data to result_cache_scalar(db and "SELECT json_extract(?,'$.data_url')" and [captured])
    if string_length(data) > 699100 || starts_with(data and "data:image/jpeg;base64,") == 0 || string_length(source) != 64 || string_length(digest) != 64:
        return pdf_error(db and "Invalid normalized image receipt")
    if sql_execute(db and "BEGIN IMMEDIATE") != 0:
        return pdf_error(db and "Cannot store image attachment")
    if result_cache_epoch(db and epoch) == 0:
        sql_execute(db and "ROLLBACK")
        return pdf_error(db and "Memory changed while importing the image")
    set existing to result_cache_scalar(db and "SELECT a.memory FROM image_assets a JOIN memories m ON m.id=a.memory WHERE a.project=? AND m.project=a.project AND m.status='active' AND a.source_sha256=? AND a.image_sha256=? AND a.payload_sha256=? AND a.data_url=? ORDER BY a.memory DESC LIMIT 1" and [project,source,digest,sha256(data),data])
    if existing != "":
        sql_execute(db and "COMMIT")
        return result_cache_scalar(db and "SELECT json_object('status','ok','memory',CAST(? AS INTEGER),'reused',json('true'))" and [existing])
    set body to result_cache_scalar(db and "SELECT json_object('kind','image_attachment','path',?,'source_sha256',?,'image_sha256',?,'width',json_extract(?,'$.width'),'height',json_extract(?,'$.height'),'normalization',json_extract(?,'$.normalization'))" and [path,source,digest,captured,captured,captured])
    if sql_execute_params(db and "INSERT INTO memories(layer,project,source,body) VALUES('reference',?,'image-attachment',?)" and [project,body]) != 101:
        sql_execute(db and "ROLLBACK")
        return pdf_error(db and "Cannot create image memory")
    set id to result_cache_scalar(db and "SELECT last_insert_rowid()" and [])
    set params to [id,project,path,source,digest,captured,captured,captured,data,sha256(data)]
    if sql_execute_params(db and "INSERT INTO image_assets SELECT CAST(? AS INTEGER),?,?,?,?,json_extract(?,'$.width'),json_extract(?,'$.height'),json_extract(?,'$.bytes'),?,?" and params) != 101 || sql_execute(db and "COMMIT") != 0:
        sql_execute(db and "ROLLBACK")
        return pdf_error(db and "Cannot commit image attachment")
    return result_cache_scalar(db and "SELECT json_object('status','ok','memory',CAST(? AS INTEGER),'reused',json('false'))" and [id])

define image_open with db and project and id and epoch returning Str:
    if result_cache_epoch(db and epoch) == 0:
        return pdf_error(db and "Image memory epoch changed")
    set rows to sql_query_params(db and "SELECT a.data_url,a.payload_sha256,m.body FROM image_assets a JOIN memories m ON m.id=a.memory WHERE a.memory=? AND a.project=? AND m.project=a.project AND m.status='active' AND length(a.data_url)<=699100" and [id,project])
    if length_list(rows) != 1:
        return pdf_error(db and "Image attachment is missing, inactive or belongs to another project")
    set row to get_list(rows and 0)
    set data to get_list(row and 0)
    if string_length(data) > 699100 || string_equals(sha256(data) and get_list(row and 1)) == 0:
        return pdf_error(db and "Image attachment integrity check failed")
    return result_cache_scalar(db and "SELECT json_object('status','ok','memory',CAST(? AS INTEGER),'data_url',?,'metadata',json(?))" and [id,data,get_list(row and 2)])
