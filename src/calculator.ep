import "fs"
import "native_calls"
# Exact rational calculator. Grammar, bounds, receipts and caching are EP.
# GMP is a native arithmetic dependency; no eval, shell or code execution is used.
import "result_cache"
import "os"
set CALCULATOR_GMP to 0

define calc_fn with name:
    return ep_dlsym(CALCULATOR_GMP and name)

define calc_error with state and message:
    if get_list(state and 2) == "":
        set_list(state and 2 and message)
    return 0

define calc_new with state:
    set value to alloc_bytes(32)
    ep_dlcall1(calc_fn("__gmpq_init") and value)
    append_list(get_list(state and 4) and value)
    return value

define calc_char with state:
    set text to get_list(state and 0)
    set position to get_list(state and 1)
    if position >= string_length(text):
        return 0
    return get_character(text and position)

define calc_advance with state:
    set_list(state and 1 and get_list(state and 1) + 1)
    return 0

define calc_spaces with state:
    set c to calc_char(state)
    repeat while c == 32 || c == 9 || c == 10 || c == 13:
        calc_advance(state)
        set c to calc_char(state)
    return 0

define calc_limit with state and value:
    if ep_dlcall2(calc_fn("__gmpz_sizeinbase") and value and 2) > 16384 || ep_dlcall2(calc_fn("__gmpz_sizeinbase") and value + 16 and 2) > 16384:
        calc_error(state and "Result exceeds calculator output budget")
    return value

define calc_number with state:
    set value to calc_new(state)
    set start to get_list(state and 1)
    set digits to create_builder()
    set fractional to 0
    set dot to 0
    set total to 0
    set previous_digit to 0
    set c to calc_char(state)
    repeat while (c >= 48 && c <= 57) || c == 46 || c == 95:
        if c == 46:
            if dot == 1:
                calc_error(state and "Invalid decimal literal")
            set dot to 1
            set previous_digit to 0
        else if c == 95:
            set next to get_character(get_list(state and 0) and get_list(state and 1) + 1)
            if previous_digit == 0 || next < 48 || next > 57:
                calc_error(state and "Invalid numeric separator")
            set previous_digit to 0
        else:
            builder_append(digits and char_from_code(c))
            set total to total + 1
            if dot == 1:
                set fractional to fractional + 1
            set previous_digit to 1
        calc_advance(state)
        set c to calc_char(state)
        if get_list(state and 1) - start > 128:
            calc_error(state and "Numeric literal exceeds 128 characters")
            return value
    if total == 0:
        calc_error(state and "Expected a number")
        return value
    set exponent to 0
    set sign to 1
    if c == 101 || c == 69:
        calc_advance(state)
        if calc_char(state) == 43 || calc_char(state) == 45:
            if calc_char(state) == 45:
                set sign to 0 - 1
            calc_advance(state)
        set exponent_digits to 0
        set c to calc_char(state)
        repeat while c >= 48 && c <= 57:
            set exponent to exponent * 10 + c - 48
            set exponent_digits to exponent_digits + 1
            calc_advance(state)
            if exponent > 1000:
                calc_error(state and "Number outside calculator limits")
                return value
            set c to calc_char(state)
        if exponent_digits == 0:
            calc_error(state and "Expected decimal exponent digits")
        set exponent to exponent * sign
    set number to builder_to_string(digits)
    set scale to fractional - exponent
    set first to 0
    repeat while first < string_length(number) - 1 && get_character(number and first) == 48:
        set first to first + 1
    set adjusted to string_length(number) - first - scale - 1
    if adjusted < -1000 || adjusted > 1000 || get_list(state and 1) - start > 128:
        calc_error(state and "Number outside calculator limits")
    if get_list(state and 2) != "":
        return value
    if ep_dlcall3(calc_fn("__gmpz_set_str") and value and number and 10) != 0:
        calc_error(state and "Invalid numeric literal")
        return value
    if scale >= 0:
        ep_dlcall3(calc_fn("__gmpz_ui_pow_ui") and value + 16 and 10 and scale)
    else:
        ep_dlcall3(calc_fn("__gmpz_ui_pow_ui") and value + 16 and 10 and 0 - scale)
        ep_dlcall3(calc_fn("__gmpz_mul") and value and value and value + 16)
        ep_dlcall2(calc_fn("__gmpz_set_ui") and value + 16 and 1)
    ep_dlcall1(calc_fn("__gmpq_canonicalize") and value)
    return calc_limit(state and value)

define calc_apply with state and operator and left and right:
    set value to calc_new(state)
    if operator == "+":
        ep_dlcall3(calc_fn("__gmpq_add") and value and left and right)
    else if operator == "-":
        ep_dlcall3(calc_fn("__gmpq_sub") and value and left and right)
    else if operator == "*":
        ep_dlcall3(calc_fn("__gmpq_mul") and value and left and right)
    else if operator == "^" || operator == "**":
        if ep_dlcall2(calc_fn("__gmpz_cmp_ui") and right + 16 and 1) != 0 || ep_dlcall2(calc_fn("__gmpz_sizeinbase") and right and 2) > 10:
            calc_error(state and "Exponent must be an integer between -1000 and 1000")
            return value
        set exponent to ep_dlcall1(calc_fn("__gmpz_get_si") and right)
        if exponent < -1000 || exponent > 1000:
            calc_error(state and "Exponent must be an integer between -1000 and 1000")
            return value
        set magnitude to exponent
        if magnitude < 0:
            set magnitude to 0 - magnitude
        if ep_dlcall2(calc_fn("__gmpz_sizeinbase") and left and 2) * magnitude > 16384 || ep_dlcall2(calc_fn("__gmpz_sizeinbase") and left + 16 and 2) * magnitude > 16384:
            calc_error(state and "Power exceeds calculator output budget")
            return value
        if exponent < 0 && ep_dlcall2(calc_fn("__gmpz_cmp_ui") and left and 0) == 0:
            calc_error(state and "Division by zero")
            return value
        if exponent >= 0:
            ep_dlcall3(calc_fn("__gmpz_pow_ui") and value and left and magnitude)
            ep_dlcall3(calc_fn("__gmpz_pow_ui") and value + 16 and left + 16 and magnitude)
        else:
            ep_dlcall3(calc_fn("__gmpz_pow_ui") and value and left + 16 and magnitude)
            ep_dlcall3(calc_fn("__gmpz_pow_ui") and value + 16 and left and magnitude)
        ep_dlcall1(calc_fn("__gmpq_canonicalize") and value)
    else:
        if ep_dlcall2(calc_fn("__gmpz_cmp_ui") and right and 0) == 0:
            calc_error(state and "Division by zero")
            return value
        ep_dlcall3(calc_fn("__gmpq_div") and value and left and right)
        if operator == "//" || operator == "%":
            ep_dlcall3(calc_fn("__gmpz_fdiv_q") and value and value and value + 16)
            ep_dlcall2(calc_fn("__gmpz_set_ui") and value + 16 and 1)
            if operator == "%":
                ep_dlcall3(calc_fn("__gmpq_mul") and value and value and right)
                ep_dlcall3(calc_fn("__gmpq_sub") and value and left and value)
    return calc_limit(state and value)

define calc_expression with state and minimum and depth:
    set left to calc_new(state)
    if depth > 32 || get_list(state and 3) >= 128:
        calc_error(state and "Expression is too complex or deeply nested")
        return left
    set_list(state and 3 and get_list(state and 3) + 1)
    calc_spaces(state)
    set c to calc_char(state)
    if c == 43 || c == 45:
        calc_advance(state)
        set left to calc_expression(state and 25 and depth + 1)
        if c == 45:
            ep_dlcall2(calc_fn("__gmpq_neg") and left and left)
    else if c == 40:
        calc_advance(state)
        set left to calc_expression(state and 0 and depth + 1)
        calc_spaces(state)
        if calc_char(state) != 41:
            calc_error(state and "Missing closing parenthesis")
        else:
            calc_advance(state)
    else if substring(get_list(state and 0) and get_list(state and 1) and 3) == "abs":
        set_list(state and 1 and get_list(state and 1) + 3)
        calc_spaces(state)
        if calc_char(state) != 40:
            calc_error(state and "abs requires one parenthesized argument")
        else:
            calc_advance(state)
            set left to calc_expression(state and 0 and depth + 1)
            calc_spaces(state)
            if calc_char(state) != 41:
                calc_error(state and "abs requires one parenthesized argument")
            else:
                calc_advance(state)
                ep_dlcall2(calc_fn("__gmpq_abs") and left and left)
    else:
        set left to calc_number(state)
    set finished to 0
    repeat while finished == 0 && get_list(state and 2) == "":
        calc_spaces(state)
        set c to calc_char(state)
        set operator to char_from_code(c)
        set width to 1
        set precedence to 0
        if c == 43 || c == 45:
            set precedence to 10
        else if c == 42 || c == 47 || c == 37:
            set precedence to 20
            set pair to substring(get_list(state and 0) and get_list(state and 1) and 2)
            if pair == "**" || pair == "//":
                set operator to pair
                set width to 2
                if pair == "**":
                    set precedence to 30
        else if c == 94:
            set precedence to 30
        if precedence == 0 || precedence < minimum:
            set finished to 1
        else:
            set_list(state and 1 and get_list(state and 1) + width)
            set next to precedence + 1
            if precedence == 30:
                set next to precedence
            set right to calc_expression(state and next and depth + 1)
            if get_list(state and 2) == "":
                set left to calc_apply(state and operator and left and right)
    return left

define calc_decimal with state and value and exact returning Str:
    set quotient to calc_new(state)
    set remainder to calc_new(state)
    ep_dlcall2(calc_fn("__gmpz_abs") and remainder and value)
    ep_dlcall4(calc_fn("__gmpz_tdiv_qr") and quotient and remainder and remainder and value + 16)
    if ep_dlcall2(calc_fn("__gmpz_sizeinbase") and quotient and 10) > 1000:
        return ""
    set buffer to alloc_bytes(1100)
    ep_dlcall3(calc_fn("__gmpz_get_str") and buffer and 10 and quotient)
    set result to ptr_to_str(buffer)
    free_bytes(buffer)
    if starts_with(exact and "-"):
        set result to concat("-" and result)
    set remaining to ep_dlcall2(calc_fn("__gmpz_cmp_ui") and remainder and 0)
    if remaining != 0:
        set result to concat(result and ".")
    set places to 0
    repeat while remaining != 0 && places < 32:
        ep_dlcall3(calc_fn("__gmpz_mul_ui") and remainder and remainder and 10)
        ep_dlcall4(calc_fn("__gmpz_tdiv_qr") and quotient and remainder and remainder and value + 16)
        set digit to ep_dlcall1(calc_fn("__gmpz_get_ui") and quotient)
        set result to concat(result and int_to_string(digit))
        set remaining to ep_dlcall2(calc_fn("__gmpz_cmp_ui") and remainder and 0)
        set places to places + 1
    if remaining != 0:
        return ""
    return result

define run_calculator with db and expression and epoch returning Str:

    set namespace to "calculator-ep-gmp630-exact-decimal-v2"
    set cached to result_cache_get(db and namespace and expression and epoch)
    if cached != "":
        return cached
    if CALCULATOR_GMP == 0:
        set library to get_env("ECHOLITE_GMP_LIBRARY")
        if library == "":
            set args to get_args()
            set library to concat(path_dirname(path_dirname(get_list(args and 0))) and "/models/runtime/libgmp.10.dylib")
        if native_android() && get_env("ECHOLITE_GMP_LIBRARY") == "":
            set library to "libecholite_gmp.so"
        set CALCULATOR_GMP to ep_dlopen(library)
    if CALCULATOR_GMP == 0:
        return "{\"status\":\"ok\",\"tool\":\"calculator\",\"outcome\":\"failed\",\"error_code\":\"unavailable\",\"text\":\"Native arithmetic library is unavailable.\"}"
    set state to create_list()
    append_list(state and expression)
    append_list(state and 0)
    append_list(state and "")
    append_list(state and 0)
    append_list(state and create_list())
    set value to 0
    if string_length(expression) == 0 || string_length(expression) > 512:
        calc_error(state and "Expression must contain 1-512 bytes")
    else:
        set value to calc_expression(state and 0 and 0)
        calc_spaces(state)
        if get_list(state and 1) != string_length(expression):
            calc_error(state and "Only numeric arithmetic, integer powers and abs() are supported")
    set outcome to "failed"
    set exact to ""
    set decimal to ""
    set text to get_list(state and 2)
    if text == "":
        set data to alloc_bytes(11000)
        ep_dlcall3(calc_fn("__gmpq_get_str") and data and 10 and value)
        set exact to ptr_to_str(data)
        free_bytes(data)
        set decimal to calc_decimal(state and value and exact)
        set text to concat(expression and concat(" = " and exact))
        if decimal != "" && string_equals(decimal and exact) == 0:
            set text to concat(expression and concat(" = " and concat(decimal and concat(" (exact decimal; exact fraction " and concat(exact and ")")))))
        set outcome to "completed"
    set allocated to get_list(state and 4)
    set i to 0
    repeat while i < length_list(allocated):
        set pointer to get_list(allocated and i)
        ep_dlcall1(calc_fn("__gmpq_clear") and pointer)
        free_bytes(pointer)
        set i to i + 1
    set result to result_cache_scalar(db and "SELECT json_object('status','ok','tool','calculator','outcome',?,'exact',?,'decimal_exact',nullif(?,''),'text',?)" and [outcome,exact,decimal,text])
    return result_cache_put(db and namespace and expression and epoch and result)
