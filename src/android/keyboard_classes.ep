# Extend SDL's Android input connection. SDL's legacy backward-delete shortcut
# only emits keys; the inherited code-point variant only edits the shadow text.
import "jvm_class"

define keyboard_delete_method with points:
    set parent to "org/libsdl/app/SDLInputConnection"
    set name to "deleteSurroundingText"
    if points:
        set name to "deleteSurroundingTextInCodePoints"
    jvm_method()
    # Negative distances are invalid. Non-backward edits use SDL/framework
    # selection semantics, then reconcile the native text once.
    jvm_emit([27])
    jvm_branch(155 and "invalid")
    jvm_emit([28])
    jvm_branch(155 and "invalid")
    jvm_emit([28])
    jvm_branch(154 and "delegate")
    jvm_emit([42])
    jvm_call(182 and parent and "getEditable" and "()Landroid/text/Editable;")
    jvm_emit([78,45])
    jvm_call(184 and "android/text/Selection" and "getSelectionStart" and "(Ljava/lang/CharSequence;)I")
    jvm_emit([54,4,45])
    jvm_call(184 and "android/text/Selection" and "getSelectionEnd" and "(Ljava/lang/CharSequence;)I")
    jvm_emit([54,5,21,4,21,5])
    jvm_branch(159 and "prefix")
    jvm_emit([27])
    jvm_branch(153 and "ok")
    jvm_emit([45,21,4,21,5])
    jvm_call(184 and "java/lang/Math" and "min" and "(II)I")
    jvm_emit([21,4,21,5])
    jvm_call(184 and "java/lang/Math" and "max" and "(II)I")
    jvm_interface("android/text/Editable" and "delete" and "(II)Landroid/text/Editable;" and 3)
    jvm_emit([87,42])
    jvm_call(182 and parent and "updateText" and "()V")
    jvm_branch(167 and "ok")
    jvm_label("prefix")
    # The app draft is bounded at 6000 UTF-8 bytes. Snapshot the whole prefix
    # so surrogate pairs can be deleted atomically with either Android API.
    jvm_emit([42])
    jvm_emit([42])
    jvm_call(182 and parent and "getEditable" and "()Landroid/text/Editable;")
    jvm_interface("java/lang/CharSequence" and "length" and "()I" and 1)
    jvm_emit([3])
    jvm_call(182 and parent and "getTextBeforeCursor" and "(II)Ljava/lang/CharSequence;")
    jvm_call(182 and "java/lang/Object" and "toString" and "()Ljava/lang/String;")
    jvm_emit([78,45])
    jvm_call(182 and "java/lang/String" and "length" and "()I")
    jvm_emit([54,4])
    # local 5 = number of units/code points the IME actually knows.
    if points:
        jvm_emit([45,3,21,4])
        jvm_call(182 and "java/lang/String" and "codePointCount" and "(II)I")
    else:
        jvm_emit([21,4])
    jvm_emit([54,5,27,21,5])
    jvm_call(184 and "java/lang/Math" and "min" and "(II)I")
    jvm_emit([54,6])
    if points:
        jvm_emit([45,21,4,21,6,116])
        jvm_call(182 and "java/lang/String" and "offsetByCodePoints" and "(II)I")
    else:
        jvm_emit([21,4,21,6,100])
    jvm_emit([54,7,21,6])
    jvm_branch(153 and "outside")
    if points == 0:
        jvm_emit([21,7])
        jvm_branch(153 and "erase")
        jvm_emit([45,21,7])
        jvm_call(182 and "java/lang/String" and "charAt" and "(I)C")
        jvm_call(184 and "java/lang/Character" and "isLowSurrogate" and "(C)Z")
        jvm_branch(153 and "erase")
        jvm_emit([132,7,255])
    jvm_label("erase")
    jvm_emit([42])
    jvm_call(182 and parent and "getEditable" and "()Landroid/text/Editable;")
    jvm_emit([21,7,21,4])
    jvm_interface("android/text/Editable" and "delete" and "(II)Landroid/text/Editable;" and 3)
    jvm_emit([87,42])
    jvm_call(182 and parent and "updateText" and "()V")
    jvm_label("outside")
    jvm_branch(167 and "ok")
    jvm_label("delegate")
    jvm_emit([42,27,28])
    jvm_call(183 and parent and name and "(II)Z")
    if points:
        jvm_branch(153 and "invalid")
        jvm_emit([42])
        jvm_call(182 and parent and "updateText" and "()V")
    else:
        jvm_emit([172])
    jvm_label("ok")
    jvm_emit([4,172])
    jvm_label("invalid")
    jvm_emit([3,172])
    return jvm_end(1 and name and "(II)Z" and 4 and 8 and [])

# Publish text and selection together after the outermost IME batch.
define keyboard_updates with parent:
    set owner to "org/libsdl/app/EchoInputConnection"
    keyboard_native("nativeOpen" and "()[B")
    keyboard_native("nativeEdit" and "(III[B)V")
    jvm_field("generation" and "I")
    jvm_field("batchDepth" and "I")
    jvm_field("target" and "Landroid/view/View;")
    jvm_method()
    jvm_emit([42,89])
    jvm_access(180 and owner and "batchDepth" and "I")
    jvm_emit([4,96])
    jvm_access(181 and owner and "batchDepth" and "I")
    jvm_emit([4,172])
    jvm_end(1 and "beginBatchEdit" and "()Z" and 3 and 1 and [])
    jvm_method()
    jvm_emit([42])
    jvm_access(180 and owner and "batchDepth" and "I")
    jvm_branch(158 and "done")
    jvm_emit([42,89])
    jvm_access(180 and owner and "batchDepth" and "I")
    jvm_emit([4,100])
    jvm_access(181 and owner and "batchDepth" and "I")
    jvm_emit([42])
    jvm_call(182 and owner and "updateText" and "()V")
    jvm_label("done")
    jvm_emit([42])
    jvm_access(180 and owner and "batchDepth" and "I")
    jvm_branch(153 and "outer")
    jvm_emit([4,172])
    jvm_label("outer")
    jvm_emit([3,172])
    jvm_end(1 and "endBatchEdit" and "()Z" and 3 and 1 and [])

    jvm_method()
    jvm_emit([42])
    jvm_access(180 and owner and "batchDepth" and "I")
    jvm_branch(154 and "done")
    jvm_emit([42])
    jvm_call(182 and parent and "getEditable" and "()Landroid/text/Editable;")
    jvm_emit([76,43])
    jvm_call(182 and "java/lang/Object" and "toString" and "()Ljava/lang/String;")
    jvm_emit([77,42,44])
    jvm_access(181 and parent and "mCommittedText" and "Ljava/lang/String;")
    jvm_emit([42])
    jvm_access(180 and owner and "generation" and "I")
    jvm_branch(153 and "done")
    jvm_emit([42])
    jvm_access(180 and owner and "generation" and "I")
    jvm_emit([43])
    jvm_call(184 and "android/text/Selection" and "getSelectionStart" and "(Ljava/lang/CharSequence;)I")
    jvm_emit([43])
    jvm_call(184 and "android/text/Selection" and "getSelectionEnd" and "(Ljava/lang/CharSequence;)I")
    jvm_emit([44])
    jvm_string("UTF-8")
    jvm_call(182 and "java/lang/String" and "getBytes" and "(Ljava/lang/String;)[B")
    jvm_call(184 and owner and "nativeEdit" and "(III[B)V")
    # Gboard uses this notification to track the composing range across
    # completion, undo-autocorrect, and subsequent cursor changes.
    jvm_emit([42])
    jvm_access(180 and owner and "target" and "Landroid/view/View;")
    jvm_call(182 and "android/view/View" and "getContext" and "()Landroid/content/Context;")
    jvm_string("input_method")
    jvm_call(182 and "android/content/Context" and "getSystemService" and "(Ljava/lang/String;)Ljava/lang/Object;")
    jvm_index(192 and jvm_class("android/view/inputmethod/InputMethodManager"))
    jvm_emit([42])
    jvm_access(180 and owner and "target" and "Landroid/view/View;")
    jvm_emit([43])
    jvm_call(184 and "android/text/Selection" and "getSelectionStart" and "(Ljava/lang/CharSequence;)I")
    jvm_emit([43])
    jvm_call(184 and "android/text/Selection" and "getSelectionEnd" and "(Ljava/lang/CharSequence;)I")
    jvm_emit([43])
    jvm_call(184 and "android/view/inputmethod/BaseInputConnection" and "getComposingSpanStart" and "(Landroid/text/Spannable;)I")
    jvm_emit([43])
    jvm_call(184 and "android/view/inputmethod/BaseInputConnection" and "getComposingSpanEnd" and "(Landroid/text/Spannable;)I")
    jvm_call(182 and "android/view/inputmethod/InputMethodManager" and "updateSelection" and "(Landroid/view/View;IIII)V")
    jvm_label("done")
    jvm_emit([177])
    jvm_end(4 and "updateText" and "()V" and 6 and 3 and [])

    jvm_method()
    jvm_emit([42,27,28])
    jvm_call(183 and parent and "setSelection" and "(II)Z")
    jvm_emit([42])
    jvm_call(182 and owner and "updateText" and "()V")
    jvm_emit([172])
    jvm_end(1 and "setSelection" and "(II)Z" and 3 and 3 and [])
    jvm_method()
    jvm_emit([43])
    jvm_call(182 and "android/view/KeyEvent" and "getKeyCode" and "()I")
    jvm_int(67)
    jvm_branch(160 and "other")
    jvm_emit([43])
    jvm_call(182 and "android/view/KeyEvent" and "getAction" and "()I")
    jvm_branch(154 and "consumed")
    jvm_emit([42,4,3])
    jvm_call(182 and owner and "deleteSurroundingText" and "(II)Z")
    jvm_emit([172])
    jvm_label("consumed")
    jvm_emit([4,172])
    jvm_label("other")
    jvm_emit([42,43])
    jvm_call(183 and parent and "sendKeyEvent" and "(Landroid/view/KeyEvent;)Z")
    jvm_emit([172])
    return jvm_end(1 and "sendKeyEvent" and "(Landroid/view/KeyEvent;)Z" and 3 and 2 and [])

define keyboard_native with name and signature:
    set method to []
    jvm_u2(method and 266)
    jvm_u2(method and jvm_utf(name))
    jvm_u2(method and jvm_utf(signature))
    jvm_u2(method and 0)
    append_list(JVM_METHODS and method)
    return 0

# Restore the actual draft and Android UTF-16 selection on every new connection.
define keyboard_seed with parent and owner:
    jvm_call(184 and owner and "nativeOpen" and "()[B")
    jvm_emit([78,45])
    jvm_branch(198 and "done")
    jvm_emit([45])
    jvm_call(184 and "java/nio/ByteBuffer" and "wrap" and "([B)Ljava/nio/ByteBuffer;")
    jvm_access(178 and "java/nio/ByteOrder" and "LITTLE_ENDIAN" and "Ljava/nio/ByteOrder;")
    jvm_call(182 and "java/nio/ByteBuffer" and "order" and "(Ljava/nio/ByteOrder;)Ljava/nio/ByteBuffer;")
    jvm_emit([58,4,25,4])
    jvm_call(182 and "java/nio/ByteBuffer" and "getInt" and "()I")
    jvm_emit([54,5])
    jvm_new("java/lang/String")
    jvm_emit([89,45])
    jvm_int(12)
    jvm_emit([45,190])
    jvm_int(12)
    jvm_emit([100])
    jvm_string("UTF-8")
    jvm_call(183 and "java/lang/String" and "<init>" and "([BIILjava/lang/String;)V")
    jvm_emit([58,6,42])
    jvm_call(182 and parent and "getEditable" and "()Landroid/text/Editable;")
    jvm_emit([25,6])
    jvm_interface("android/text/Editable" and "append" and "(Ljava/lang/CharSequence;)Landroid/text/Editable;" and 2)
    jvm_emit([25,4])
    jvm_call(182 and "java/nio/ByteBuffer" and "getInt" and "()I")
    jvm_emit([25,4])
    jvm_call(182 and "java/nio/ByteBuffer" and "getInt" and "()I")
    jvm_call(184 and "android/text/Selection" and "setSelection" and "(Landroid/text/Spannable;II)V")
    jvm_emit([42,25,6])
    jvm_access(181 and parent and "mCommittedText" and "Ljava/lang/String;")
    jvm_emit([42,21,5])
    jvm_access(181 and owner and "generation" and "I")
    jvm_emit([42])
    jvm_call(182 and owner and "updateText" and "()V")
    jvm_label("done")
    return 0

define keyboard_connection with output:
    set parent to "org/libsdl/app/SDLInputConnection"
    jvm_begin("org/libsdl/app/EchoInputConnection" and parent and [])
    jvm_method()
    jvm_emit([42,43,28])
    jvm_call(183 and parent and "<init>" and "(Landroid/view/View;Z)V")
    jvm_emit([42,43])
    jvm_access(181 and "org/libsdl/app/EchoInputConnection" and "target" and "Landroid/view/View;")
    keyboard_seed(parent and "org/libsdl/app/EchoInputConnection")
    jvm_emit([177])
    jvm_end(1 and "<init>" and "(Landroid/view/View;Z)V" and 6 and 7 and [])
    keyboard_updates(parent)
    keyboard_delete_method(0)
    keyboard_delete_method(1)
    return jvm_write(concat(output and "/org/libsdl/app/EchoInputConnection.class"))

# Compile SDL's unmodified view behavior with the EP-generated connection
# selected at its one construction site. Keep the upstream dependency intact.
define keyboard_sdl_jar with work and jdk and output:
    set package to concat(output and "/org/libsdl/app")
    application_directory(package and 0)
    keyboard_connection(output)
    set upstream to read_file(concat(work and "/vendor/SDL-release-3.4.20/android-project/app/src/main/java/org/libsdl/app/SDLDummyEdit.java"))
    set factory to "new SDLInputConnection(this, true)"
    if length_list(string_split(upstream and factory)) != 2:
        display "Unexpected SDL input connection factory"
        return 1
    set source to concat(package and "/SDLDummyEdit.java")
    set patched_view to string_replace(upstream and factory and "new EchoInputConnection(this, true)")
    set selection to "android.text.Editable initial = ((EchoInputConnection)ic).getEditable();\n        outAttrs.initialSelStart = android.text.Selection.getSelectionStart(initial);\n        outAttrs.initialSelEnd = android.text.Selection.getSelectionEnd(initial);\n        return ic;"
    write_file(source and string_replace(patched_view and "return ic;" and selection))
    set jar to concat(work and "/build/sdl-classes.jar")
    set sdk to concat(work and "/sdk/platforms/android-36/android.jar")
    set classpath to concat(output and concat(":" and concat(jar and concat(":" and sdk))))
    if application_wait(concat(jdk and "/bin/javac") and ["-source","8","-target","8","-classpath",classpath,"-d",output,source]) != 0:
        return 1
    set patched to concat(output and "/sdl-input.jar")
    if application_wait("/bin/cp" and [jar,patched]) != 0:
        return 1
    return application_wait(concat(jdk and "/bin/jar") and ["uf",patched,"-C",output,"org/libsdl/app/SDLDummyEdit.class","-C",output,"org/libsdl/app/EchoInputConnection.class"])
