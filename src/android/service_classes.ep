define main:
    set args to get_args()
    if length_list(args) != 2:
        display "Usage: service_classes OUTPUT_DIRECTORY"
        return 1
    set output to get_list(args and 1)
    application_directory(output and 0)
    service_components(output)
    display "Generated Android lifecycle classes directly from Ernos Plain"
    return 0
