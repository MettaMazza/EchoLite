    jvm_call(182 and "java/io/File" and "getAbsolutePath" and "()Ljava/lang/String;")
    jvm_string(suffix)
    return jvm_call(182 and "java/lang/String" and "concat" and "(Ljava/lang/String;)Ljava/lang/String;")

