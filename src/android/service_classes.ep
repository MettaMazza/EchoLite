# Android lifecycle components expressed in EP and emitted as JVM bytecode.
# Only platform lifecycle lives here; replication and scheduling stay in sync_agent.ep.
import "jvm_class"
set SYNC_CLASS to "dev/echolite/android/SyncService"

define service_get with name and signature:
    jvm_emit([42])
    return jvm_access(180 and SYNC_CLASS and name and signature)

