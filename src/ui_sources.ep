import "ui_style"
import "chat_sources"
set SOURCES_OPEN to ""
set SOURCE_CHILD to 0
set SOURCE_NOTICE to ""

define ui_sources with db and turn_id and sources and x and y and width:
    if SOURCE_CHILD > 0:
        set outcome to process_poll(SOURCE_CHILD)
        if outcome != 0 - 1:
            set SOURCE_CHILD to 0
            if outcome != 0:
                set SOURCE_NOTICE to "Could not open source. Copy its link and open it manually."
    set rows to source_rows(db and sources)
    if length_list(rows) == 0:
        return y
    set y to y + 18
    set opened to string_equals(SOURCES_OPEN and turn_id)
    set hovered to raylib_get_mouse_x() >= x && raylib_get_mouse_x() < x + width && raylib_get_mouse_y() >= y && raylib_get_mouse_y() < y + 36 && raylib_get_mouse_y() >= SELECT_TOP && raylib_get_mouse_y() < SELECT_BOTTOM
    set fill to ui_color(28 and 34 and 39)
    if hovered:
        set fill to ui_color(35 and 43 and 47)
        ep_dlcall1(ep_dlsym(RAYLIB_HANDLE and "SetMouseCursor") and 4)
    ui_frame(x and y and width and 36 and fill and ui_color(45 and 53 and 61))
    set arrow to ">"
    if opened:
        set arrow to "v"
    font_draw(concat(arrow and concat("  Sources / " and int_to_string(length_list(rows)))) and x + 14 and y + 11 and 13 and ui_color(189 and 229 and 201))
    if hovered && raylib_is_mouse_button_pressed(0):
        set SOURCES_OPEN to ""
        if opened == 0:
            set SOURCES_OPEN to turn_id
        set opened to string_equals(SOURCES_OPEN and turn_id)
    set y to y + 44
    if opened == 0:
        return y
    font_draw("Consulted references / click a title to open" and x + 14 and y and 11 and ui_color(148 and 159 and 169))
    set y to y + 26
    set i to 0
    repeat while i < length_list(rows):
        set row to get_list(rows and i)
        set url to get_list(row and 0)
        set title to source_title(url and get_list(row and 1))
        set detail to source_host(url)
        if get_list(row and 2) != "":
            set detail to concat(detail and concat(" / snapshot " and get_list(row and 2)))
        set title_lines to layout_lines(title and width - 88 and 15)
        set card_height to length_list(title_lines) * 24 + 42
        set inside to raylib_get_mouse_x() >= x && raylib_get_mouse_x() < x + width - 58 && raylib_get_mouse_y() >= y && raylib_get_mouse_y() < y + card_height && raylib_get_mouse_y() >= SELECT_TOP && raylib_get_mouse_y() < SELECT_BOTTOM
        set fill to ui_color(24 and 29 and 34)
        if inside:
            set fill to ui_color(31 and 41 and 39)
            ep_dlcall1(ep_dlsym(RAYLIB_HANDLE and "SetMouseCursor") and 4)
        ui_frame(x and y and width and card_height and fill and ui_color(45 and 53 and 61))
        set line_i to 0
        repeat while line_i < length_list(title_lines):
            font_draw(get_list(title_lines and line_i) and x + 16 and y + 12 + line_i * 24 and 15 and ui_color(189 and 229 and 201))
            set line_i to line_i + 1
        font_draw(ui_text_fit(detail and width - 40 and 11) and x + 16 and y + card_height - 20 and 11 and ui_color(148 and 159 and 169))
        font_draw("Copy" and x + width - 48 and y + 14 and 11 and ui_color(148 and 159 and 169))
        if raylib_is_mouse_button_pressed(0) && raylib_get_mouse_y() >= SELECT_TOP && raylib_get_mouse_y() < SELECT_BOTTOM:
            if inside && SOURCE_CHILD == 0:
                set SOURCE_CHILD to source_open(url)
                set SOURCE_NOTICE to ""
                if SOURCE_CHILD == 0:
                    set SOURCE_NOTICE to "This source cannot be opened. Use Copy to inspect its link."
            else if raylib_get_mouse_x() >= x + width - 58 && raylib_get_mouse_x() < x + width && raylib_get_mouse_y() >= y && raylib_get_mouse_y() < y + card_height:
                ep_dlcall1(ep_dlsym(RAYLIB_HANDLE and "SetClipboardText") and url)
                set SOURCE_NOTICE to "Source link copied."
        set y to y + card_height + 8
        set i to i + 1
    if SOURCE_NOTICE != "":
        font_draw(ui_text_fit(SOURCE_NOTICE and width - 24 and 11) and x + 12 and y + 2 and 11 and ui_color(148 and 159 and 169))
        set y to y + 24
    return y
