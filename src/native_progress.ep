# Latest in-flight snapshot only. Durable finished rounds live in generation_rounds.
import "result_cache"
set PROGRESS_TURN to ""
set PROGRESS_ROUND to ""
set PROGRESS_EPOCH to ""
set PROGRESS_LAST to 0

set DECISION_TRACE to "{}"

define progress_merge with db and earlier and current returning Str:
    if earlier == "{}":
        return current
    return result_cache_scalar(db and "WITH calls(j) AS (VALUES(?1),(?2)) SELECT json_set(?2,'$.reasoning',(SELECT group_concat(nullif(json_extract(j,'$.reasoning'),''),char(10)||char(10)) FROM calls),'$.completion_tokens',(SELECT sum(json_extract(j,'$.completion_tokens')) FROM calls),'$.reasoning_tokens',(SELECT CASE WHEN count(json_extract(j,'$.reasoning_tokens'))=count(*) THEN sum(json_extract(j,'$.reasoning_tokens')) END FROM calls))" and [earlier,current])

define progress_scope with turn and round and epoch:
    set PROGRESS_TURN to turn
    set PROGRESS_ROUND to round
    set PROGRESS_EPOCH to epoch
    set PROGRESS_LAST to 0
    return 0

define progress_initialize with db:
    return sql_execute(db and "CREATE TABLE IF NOT EXISTS model_progress(turn_id INTEGER PRIMARY KEY REFERENCES turns(id) ON DELETE CASCADE,round INTEGER NOT NULL,epoch TEXT NOT NULL,response TEXT NOT NULL,updates INTEGER NOT NULL DEFAULT 1); CREATE TRIGGER IF NOT EXISTS progress_turn_finished AFTER UPDATE OF status ON turns WHEN new.status!='pending' BEGIN DELETE FROM model_progress WHERE turn_id=new.id; END;")

define progress_publish with db and snapshot and now and force:
    if PROGRESS_TURN == "":
        return 0
    if force == 0 && now - PROGRESS_LAST < 150:
        return 0
    set PROGRESS_LAST to now
    # A single guarded statement cannot resurrect forgotten or abandoned output.
    set params to [PROGRESS_TURN,PROGRESS_ROUND,PROGRESS_EPOCH,progress_merge(db and DECISION_TRACE and snapshot),PROGRESS_TURN,PROGRESS_EPOCH]
    set rc to sql_execute_params(db and "INSERT INTO model_progress(turn_id,round,epoch,response) SELECT ?,CAST(? AS INTEGER),?,? WHERE EXISTS(SELECT 1 FROM turns WHERE id=? AND status='pending') AND (SELECT value FROM metadata WHERE key='cache_epoch')=? ON CONFLICT(turn_id) DO UPDATE SET round=excluded.round,epoch=excluded.epoch,response=excluded.response,updates=model_progress.updates+1" and params)
    return rc == 101

# Decode a top-level JSON string as it arrives, never displaying raw tool JSON.
# Prefixes ending in incomplete escapes are withheld until the next update.
define progress_answer with db and action returning Str:
    set pos to 0
    set size to string_length(action)
    set depth to 0
    set key to ""
    set kind to ""
    set expecting_key to 0
    repeat while pos < size:
        set byte to get_character(action and pos)
        if byte == 123:
            set depth to depth + 1
            if depth == 1:
                set expecting_key to 1
        else if byte == 125:
            set depth to depth - 1
        else if byte == 44 && depth == 1:
            set expecting_key to 1
        else if byte == 34:
            set start to pos
            set pos to pos + 1
            set escaped to 0
            repeat while pos < size:
                set byte to get_character(action and pos)
                if escaped == 0 && byte == 34:
                    break
                if escaped == 0 && byte == 92:
                    set escaped to 1
                else:
                    set escaped to 0
                set pos to pos + 1
            set complete to pos < size
            set encoded to substring(action and start and pos - start)
            set encoded to concat(encoded and "\"")
            if complete == 0:
                set safe_end to pos
                repeat while result_cache_scalar(db and "SELECT json_valid(?)" and [encoded]) != "1" && safe_end > start + 1:
                    set safe_end to safe_end - 1
                    set encoded to concat(substring(action and start and safe_end - start) and "\"")
            if result_cache_scalar(db and "SELECT json_valid(?)" and [encoded]) == "1":
                set decoded to result_cache_scalar(db and "SELECT json_extract(?,'$')" and [encoded])
                if depth == 1:
                    if expecting_key == 1:
                        set key to decoded
                        set expecting_key to 0
                    else:
                        if key == "type" && complete:
                            set kind to decoded
                        if key == "text" && kind == "answer":
                            return decoded
            if complete == 0:
                return ""
        set pos to pos + 1
    return ""
