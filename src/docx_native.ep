# DOCX ZIP extraction through libarchive; never writes archive entries to disk.
import "pdf_native"
import "docx_markup"

define docx_extract with db and path returning Str:
    set snapshot to pdf_snapshot(db and path)
    if get_list(snapshot and 0) == 0:
        return pdf_error(db and string_replace(get_list(snapshot and 3) and "PDF" and "DOCX"))
    set library to ep_dlopen("/usr/lib/libarchive.2.dylib")
    set archive to ep_dlcall0(ep_dlsym(library and "archive_read_new"))
    if archive == 0:
        free_bytes(get_list(snapshot and 0))
        return pdf_error(db and "Cannot allocate native DOCX archive reader")
    ep_dlcall1(ep_dlsym(library and "archive_read_support_format_zip") and archive)
    set problem to ""
    if ep_dlcall3(ep_dlsym(library and "archive_read_open_memory") and archive and get_list(snapshot and 0) and get_list(snapshot and 1)) != 0:
        set problem to "Invalid DOCX ZIP archive"
    set entry_pointer to alloc_bytes(8)
    set found to 0
    set count to 0
    set source to ""
    set done to 0
    repeat while problem == "" && done == 0:
        set code to ep_dlcall2(ep_dlsym(library and "archive_read_next_header") and archive and entry_pointer)
        if code == 1:
            set done to 1
        else if code != 0:
            set problem to "Invalid DOCX archive entry"
        else:
            set count to count + 1
            set entry to lease_integer(entry_pointer and 0 and 8)
            set name_pointer to ep_dlcall1(ep_dlsym(library and "archive_entry_pathname") and entry)
            set name to ""
            if name_pointer != 0:
                set name to ptr_to_str(name_pointer)
            set lower to result_cache_scalar(db and "SELECT lower(?)" and [name])
            if count > 2048:
                set problem to "DOCX exceeds 2048 ZIP entries"
            else if ends_with(lower and "vbaproject.bin"):
                set problem to "Macro-bearing Word documents are unsupported"
            else if ep_dlcall1(ep_dlsym(library and "archive_entry_is_encrypted") and entry) != 0:
                set problem to "Encrypted DOCX entries are unsupported"
            else if name == "word/document.xml":
                set found to found + 1
                set size to ep_dlcall1(ep_dlsym(library and "archive_entry_size") and entry)
                if found != 1 || size < 1 || size > 2097152:
                    set problem to "DOCX requires one main XML part of at most 2 MiB"
                else:
                    set data to alloc_bytes(2097154)
                    set used to 0
                    set finished to 0
                    repeat while problem == "" && finished == 0:
                        set received to ep_dlcall3(ep_dlsym(library and "archive_read_data") and archive and data + used and 2097153 - used)
                        if received == 0:
                            set finished to 1
                        else if received < 0 || received > 2097153 - used:
                            set problem to "Cannot decompress DOCX main XML"
                        else:
                            set used to used + received
                            if used > 2097152:
                                set problem to "DOCX expanded XML exceeds 2 MiB"
                    if problem == "":
                        if used != size || document_utf8(data and used) == 0 || ep_dlcall3(ep_dlsym(native_system() and "memchr") and data and 0 and used) != 0:
                            set problem to "DOCX XML must be complete UTF-8 without NUL bytes"
                        else:
                            set source to ptr_to_str(data)
                    free_bytes(data)
            else:
                if ep_dlcall1(ep_dlsym(library and "archive_read_data_skip") and archive) != 0:
                    set problem to "Cannot skip DOCX archive entry"
    ep_dlcall1(ep_dlsym(library and "archive_read_free") and archive)
    free_bytes(entry_pointer)
    free_bytes(get_list(snapshot and 0))
    if problem == "" && found != 1:
        set problem to "DOCX has no main document part"
    if problem != "":
        return pdf_error(db and problem)
    set result to docx_xml(db and source)
    set digest to get_list(snapshot and 2)
    return result_cache_scalar(db and "SELECT json_set(?,'$.source_sha256',?,'$.parser_version','EP WordprocessingML / libarchive / libxml2')" and [result,digest])
