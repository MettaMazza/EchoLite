import "native_calls"
# Local HTTP transport. Protocol handling, limits and deadlines are Ernos Plain.
# libc provides socket syscalls only. Requests never follow redirects or retry.
import "os"
import "string"
import "json"
import "fs"

define transport_error with message returning Str:
    set values to [create_json_string("transport_error"),create_json_string(concat(message and "; execution outcome may be unknown. No automatic retry."))]
    set result to json_stringify(create_json_object(["status","text"] and values))
    return result

define transport_number with value and base and ceiling:
    if string_length(value) == 0:
        return 0 - 1
    set result to 0
    set i to 0
    repeat while i < string_length(value):
        set code to to_lower_char(get_character(value and i))
        set digit to 0 - 1
        if code >= 48 && code <= 57:
            set digit to code - 48
        if code >= 97 && code <= 102:
            set digit to code - 87
        if digit < 0 || digit >= base:
            return 0 - 1
        if result > (ceiling - digit) / base:
            return 0 - 1
        set result to result * base + digit
        if result > ceiling:
            return 0 - 1
        set i to i + 1
    return result

# state: phase, pending bytes, decoded body, remaining bytes, error, wire bytes
# phases: headers=0, fixed=1, EOF=2, chunk-size=3, chunk-data=4, trailers=5, done=6

define transport_parser:
    set state to create_list()
    append_list(state and 0)
    append_list(state and "")
    append_list(state and "")
    append_list(state and 0)
    append_list(state and "")
    append_list(state and 0)
    append_list(state and 2097152)
    return state

define transport_parse with state and incoming and eof:
    set wire to get_list(state and 5) + string_length(incoming)
    set_list(state and 5 and wire)
    if wire > get_list(state and 6):
        set_list(state and 4 and "Local response exceeded wire limit")
        return 0
    set buffer to concat(get_list(state and 1) and incoming)
    set body to get_list(state and 2)
    set phase to get_list(state and 0)
    set remaining to get_list(state and 3)
    set error to get_list(state and 4)
    set advance to 1
    repeat while advance == 1 && error == "" && phase != 6:
        set advance to 0
        if phase == 0:
            set end to string_index_of(buffer and "\r\n\r\n")
            if end < 0:
                if string_length(buffer) > 16384:
                    set error to "Local response headers exceeded limit"
            else if end > 16384:
                set error to "Local response headers exceeded limit"
            else:
                set lines to string_split(substring(buffer and 0 and end) and "\r\n")
                set status to get_list(lines and 0)
                if starts_with(status and "HTTP/1.1 200 ") == 0 && starts_with(status and "HTTP/1.0 200 ") == 0:
                    set error to "Local runtime returned a non-success HTTP status"
                set length_seen to 0
                set transfer_seen to 0
                set phase to 2
                set i to 1
                repeat while i < length_list(lines) && error == "":
                    set line to get_list(lines and i)
                    set colon to string_index_of(line and ":")
                    if colon <= 0:
                        set error to "Malformed HTTP header"
                    else:
                        set name to string_to_lower(substring(line and 0 and colon))
                        set value to string_trim(substring(line and colon + 1 and string_length(line) - colon - 1))
                        if name == "content-length":
                            set length_seen to length_seen + 1
                            set remaining to transport_number(value and 10 and 1048576)
                            if remaining < 0 || length_seen > 1:
                                set error to "Invalid or oversized Content-Length"
                            set phase to 1
                        else if name == "transfer-encoding":
                            set transfer_seen to transfer_seen + 1
                            if string_to_lower(value) != "chunked" || transfer_seen > 1:
                                set error to "Unsupported Transfer-Encoding"
                        else if name == "content-encoding" && string_to_lower(value) != "identity":
                            set error to "Unsupported Content-Encoding"
                    set i to i + 1
                if transfer_seen == 1:
                    set phase to 3
                    if length_seen != 0:
                        set error to "Ambiguous HTTP framing"
                set buffer to substring(buffer and end + 4 and string_length(buffer) - end - 4)
                set advance to 1
        else if phase == 1:
            if string_length(buffer) >= remaining:
                set body to substring(buffer and 0 and remaining)
                set buffer to substring(buffer and remaining and string_length(buffer) - remaining)
                set phase to 6
        else if phase == 2:
            set body to concat(body and buffer)
            set buffer to ""
            if eof == 1:
                set phase to 6
        else if phase == 3:
            set end to string_index_of(buffer and "\r\n")
            if end < 0:
                if string_length(buffer) > 1024:
                    set error to "Oversized chunk header"
            else if end > 1024:
                set error to "Oversized chunk header"
            else:
                set size_text to substring(buffer and 0 and end)
                set extension to string_index_of(size_text and ";")
                if extension >= 0:
                    set size_text to substring(size_text and 0 and extension)
                set remaining to transport_number(size_text and 16 and 1048576 - string_length(body))
                set buffer to substring(buffer and end + 2 and string_length(buffer) - end - 2)
                if remaining < 0:
                    set error to "Invalid or oversized chunk"
                else if remaining == 0:
                    set phase to 5
                else:
                    set phase to 4
                set advance to 1
        else if phase == 4:
            if string_length(buffer) >= remaining + 2:
                if substring(buffer and remaining and 2) != "\r\n":
                    set error to "Invalid chunk terminator"
                else:
                    set body to concat(body and substring(buffer and 0 and remaining))
                    set buffer to substring(buffer and remaining + 2 and string_length(buffer) - remaining - 2)
                    set phase to 3
                    set advance to 1
        else if phase == 5:
            if starts_with(buffer and "\r\n") == 1:
                set buffer to substring(buffer and 2 and string_length(buffer) - 2)
                set phase to 6
            else:
                set end to string_index_of(buffer and "\r\n\r\n")
                if end >= 0 && end <= 8192:
                    set buffer to substring(buffer and end + 4 and string_length(buffer) - end - 4)
                    set phase to 6
                else if string_length(buffer) > 8192:
                    set error to "Oversized HTTP trailers"
        if string_length(body) > 1048576 || string_length(buffer) > 1064960:
            set error to "Local response exceeded 1 MiB body limit"
    if eof == 1 && phase != 6 && error == "":
        set error to "Truncated local HTTP response"
    if phase == 6 && buffer != "":
        set error to "Unexpected bytes after local response"
    set_list(state and 0 and phase)
    set_list(state and 1 and buffer)
    set_list(state and 2 and body)
    set_list(state and 3 and remaining)
    set_list(state and 4 and error)
    return phase == 6 && error == ""

define transport_u32 with pointer and offset and value:
    set number to value
    set i to 0
    repeat while i < 4:
        poke_byte(pointer and offset + i and number % 256)
        set number to number / 256
        set i to i + 1
    return 0

define transport_now with libc:
    if native_android():
        set stamp to alloc_bytes(16)
        ep_dlcall2(ep_dlsym(libc and "clock_gettime") and 1 and stamp)
        set seconds to peek_byte(stamp and 0) + peek_byte(stamp and 1) * 256 + peek_byte(stamp and 2) * 65536 + peek_byte(stamp and 3) * 16777216
        set nanos to peek_byte(stamp and 8) + peek_byte(stamp and 9) * 256 + peek_byte(stamp and 10) * 65536 + peek_byte(stamp and 11) * 16777216
        free_bytes(stamp)
        return seconds * 1000 + nanos / 1000000
    return ep_dlcall1(ep_dlsym(libc and "clock_gettime_nsec_np") and 6) / 1000000

define transport_errno with libc:
    set pointer to native_errno_pointer()
    return peek_byte(pointer and 0)

define transport_wait_cancel with libc and pollfd and fd and event and deadline and cancel:
    transport_u32(pollfd and 0 and fd)
    poke_byte(pollfd and 4 and event)
    poke_byte(pollfd and 5 and 0)
    repeat while transport_now(libc) < deadline:
        if cancel != "" && file_exists(cancel):
            return 0 - 1
        poke_byte(pollfd and 6 and 0)
        poke_byte(pollfd and 7 and 0)
        set timeout to deadline - transport_now(libc)
        if timeout < 0:
            return 0
        if cancel != "" && timeout > 100:
            set timeout to 100
        set result to ep_dlcall3(ep_dlsym(libc and "poll") and pollfd and 1 and timeout)
        if result > 0 && result < 2147483647:
            return 1
        if result == 0 && transport_now(libc) >= deadline:
            return 0
        if result != 0 && transport_errno(libc) != 4:
            return 0
    return 0

define transport_request_cancel with method and port and path and token and payload and long_running and progress and cancel returning Str:
    if cancel != "" && file_exists(cancel):
        return transport_error("Local request cancelled")
    if method != "POST" && method != "GET":
        return transport_error("Unsupported local request method")
    if port < 1 || port > 65535:
        return transport_error("Invalid local runtime port")
    if starts_with(path and "/") == 0 || string_length(path) > 8192 || string_length(token) > 512:
        return transport_error("Invalid local request")
    set i to 0
    repeat while i < string_length(path):
        set ch to get_character(path and i)
        if ch <= 32 || ch >= 127 || ch == 35:
            return transport_error("Invalid local request path")
        set i to i + 1
    if string_contains(token and "\r") || string_contains(token and "\n"):
        return transport_error("Invalid local authorization")
    set setting to get_env("ECHOLITE_REQUEST_TIMEOUT_MS")
    set timeout to 120000
    if setting != "":
        set timeout to transport_number(setting and 10 and 600000)
        if timeout < 100:
            return transport_error("Invalid request timeout")
    set idle to 120000
    if long_running == 1:
        set inference to get_env("ECHOLITE_INFERENCE_TIMEOUT_MS")
        if inference != "":
            set timeout to transport_number(inference and 10 and 86400000)
            if timeout < 100:
                return transport_error("Invalid inference timeout")
        else if setting == "":
            set timeout to 86400000
        set idle_setting to get_env("ECHOLITE_INFERENCE_IDLE_SECONDS")
        if idle_setting != "":
            set idle to transport_number(idle_setting and 10 and 600) * 1000
            if idle < 1000:
                return transport_error("Invalid inference idle timeout")
    set libc to native_system()
    set socket_level to 65535
    set socket_error to 4103
    set in_progress to 36
    set again to 35
    set send_flags to 0
    if native_android():
        set socket_level to 1
        set socket_error to 4
        set in_progress to 115
        set again to 11
        set send_flags to 16384
    set fd to ep_dlcall3(ep_dlsym(libc and "socket") and 2 and 1 and 0)
    if fd < 0 || fd > 2147483647:
        return transport_error("Local socket creation failed")
    set pollfd to alloc_bytes(8)
    set address to alloc_bytes(16)
    set option to alloc_bytes(4)
    poke_byte(address and 0 and 16)
    poke_byte(address and 1 and 2)
    if native_android():
        poke_byte(address and 0 and 2)
        poke_byte(address and 1 and 0)
    poke_byte(address and 2 and port / 256)
    poke_byte(address and 3 and port % 256)
    poke_byte(address and 4 and 127)
    poke_byte(address and 7 and 1)
    transport_u32(option and 0 and 1)
    set error to ""
    if native_fcntl_int(fd and 4 and 4) != 0 || native_fcntl_int(fd and 2 and 1) != 0:
        set error to "Socket configuration failed"
    if native_android() == 0 && ep_dlcall5(ep_dlsym(libc and "setsockopt") and fd and 65535 and 4130 and option and 4) != 0:
        set error to "Socket signal configuration failed"
    set deadline to transport_now(libc) + timeout
    if error == "":
        set result to ep_dlcall3(ep_dlsym(libc and "connect") and fd and address and 16)
        if result != 0:
            if transport_errno(libc) != in_progress:
                set error to "Local connection failed"
            else:
                set connect_deadline to transport_now(libc) + 2000
                if connect_deadline > deadline:
                    set connect_deadline to deadline
                if transport_wait_cancel(libc and pollfd and fd and 4 and connect_deadline and cancel) <= 0:
                    set error to "Local connection deadline exceeded"
                else:
                    transport_u32(address and 0 and 4)
                    transport_u32(option and 0 and 0)
                    set rc to ep_dlcall5(ep_dlsym(libc and "getsockopt") and fd and socket_level and socket_error and option and address)
                    if rc != 0 || peek_byte(option and 0) != 0:
                        set error to "Local connection failed"
    set host to concat(" HTTP/1.1\r\nHost: 127.0.0.1:" and concat(int_to_string(port) and "\r\nConnection: close\r\nContent-Type: application/json\r\nAuthorization: Bearer "))
    set header to concat(method and concat(" " and concat(path and host)))
    set request to concat(header and concat(token and concat("\r\nContent-Length: " and concat(int_to_string(string_length(payload)) and concat("\r\n\r\n" and payload)))))
    set sent to 0
    repeat while sent < string_length(request) && error == "":
        if transport_wait_cancel(libc and pollfd and fd and 4 and deadline and cancel) <= 0:
            set error to "Local request deadline exceeded"
        else:
            set n to ep_dlcall4(ep_dlsym(libc and "send") and fd and str_to_ptr(request) + sent and string_length(request) - sent and send_flags)
            if n > 0:
                set sent to sent + n
            else if n == 0:
                set error to "Local connection closed during request"
            else if transport_errno(libc) != 4 && transport_errno(libc) != again:
                set error to "Local request send failed"
    set state to transport_parser()
    set streaming_model to progress != 0 && path == "/v1/chat/completions"
    if streaming_model:
        # SSE repeats JSON metadata per token. Bound the wire separately from
        # the decoded model text; release each delivered block immediately.
        set_list(state and 6 and 67108864)
    set data to alloc_bytes(16385)
    set emitted to 0
    set last_activity to transport_now(libc)
    repeat while error == "" && get_list(state and 0) != 6:
        set receive_deadline to deadline
        if long_running == 1 && last_activity + idle < receive_deadline:
            set receive_deadline to last_activity + idle
        if transport_wait_cancel(libc and pollfd and fd and 1 and receive_deadline and cancel) <= 0:
            set error to "Local request or inference idle deadline exceeded"
        else:
            set n to ep_dlcall4(ep_dlsym(libc and "recv") and fd and data and 16384 and 0)
            if n == 0:
                transport_parse(state and "" and 1)
                set error to get_list(state and 4)
            else if n < 0:
                if transport_errno(libc) != 4 && transport_errno(libc) != again:
                    set error to "Local response read failed"
            else:
                set last_activity to transport_now(libc)
                set i to 0
                repeat while i < n:
                    if peek_byte(data and i) == 0:
                        set error to "Local response contained NUL bytes"
                    set i to i + 1
                if error == "":
                    poke_byte(data and n and 0)
                    transport_parse(state and ptr_to_str(data) and 0)
                    set error to get_list(state and 4)
        if progress != 0 && error == "":
            set decoded to get_list(state and 2)
            if string_length(decoded) > emitted:
                set delta to concat("data\n" and substring(decoded and emitted and string_length(decoded) - emitted))
                send delta to progress
                set emitted to string_length(decoded)
                if streaming_model:
                    set_list(state and 2 and "")
                    set emitted to 0
    ep_dlcall1(ep_dlsym(libc and "close") and fd)
    free_bytes(data)
    free_bytes(option)
    free_bytes(address)
    free_bytes(pollfd)
    if cancel != "" && file_exists(cancel):
        return transport_error("Local request cancelled")
    if error != "":
        return transport_error(error)
    return get_list(state and 2)


define local_post with path and token and payload returning Str:
    if string_contains(path and "?"):
        return transport_error("Invalid local request path")
    set long_running to 0
    if path == "/generate":
        set long_running to 1
    set response to transport_post(8399 and path and token and payload and long_running and 0)
    return response

define transport_post with port and path and token and payload and long_running and progress returning Str:
    set response to transport_request("POST" and port and path and token and payload and long_running and progress)
    return response

define transport_get with port and path and token returning Str:
    set response to transport_request("GET" and port and path and token and "" and 0 and 0)
    return response

# Existing non-cancellable callers retain their original interface.
define transport_wait with libc and pollfd and fd and event and deadline:
    return transport_wait_cancel(libc and pollfd and fd and event and deadline and "")

define transport_request with method and port and path and token and payload and long_running and progress returning Str:
    set result to transport_request_cancel(method and port and path and token and payload and long_running and progress and "")
    return result
