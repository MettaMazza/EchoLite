# Native llama.cpp b12359 slot persistence protocol; no model text in filenames.
import "transport"
import "result_cache"
import "state_lock"

define slot_filename with filename:
    if string_length(filename) != 77 || starts_with(filename and "echolite-") == 0 || substring(filename and 73 and 4) != ".bin":
        return 0
    set i to 9
    repeat while i < 73:
        set c to get_character(filename and i)
        if (c < 48 || c > 57) && (c < 97 || c > 102):
            return 0
        set i to i + 1
    return 1

define slot_receipt with db and action and filename and response returning Str:
    if action != "save" && action != "restore" && action != "erase":
        return lease_error("Invalid slot cache operation")
    if action != "erase" && slot_filename(filename) == 0:
        return lease_error("Invalid slot cache filename")
    if result_cache_scalar(db and "SELECT json_valid(?)" and [response]) != "1":
        return lease_error("Invalid slot cache response")
    set count_field to "n_saved"
    set bytes_field to "n_written"
    if action == "restore":
        set count_field to "n_restored"
        set bytes_field to "n_read"
    if action == "erase":
        set count_field to "n_erased"
    set valid to result_cache_scalar(db and "SELECT json_type(?,'$.id_slot')='integer' AND json_extract(?,'$.id_slot')=0 AND json_type(?,?)='integer' AND json_extract(?,?) BETWEEN 0 AND 262144" and [response,response,response,concat("$." and count_field),response,concat("$." and count_field)])
    if valid != "1":
        return lease_error("Slot cache response has invalid slot or token count")
    if action != "erase":
        set valid to result_cache_scalar(db and "SELECT json_extract(?,'$.filename')=? AND json_type(?,?)='integer' AND json_extract(?,?) BETWEEN 1 AND 8589934592" and [response,filename,response,concat("$." and bytes_field),response,concat("$." and bytes_field)])
        if valid != "1":
            return lease_error("Slot cache response has invalid filename or byte count")
    return result_cache_scalar(db and "SELECT json_set(?,'$.status','ok','$.operation',?)" and [response,action])

define slot_control_at with db and token and action and filename and port returning Str:
    if action != "save" && action != "restore" && action != "erase":
        return lease_error("Invalid slot cache operation")
    if action != "erase" && slot_filename(filename) == 0:
        return lease_error("Invalid slot cache filename")
    set payload to result_cache_scalar(db and "SELECT json_object('filename',?)" and [filename])
    if action == "erase":
        set payload to "{}"
    set response to transport_post(port and concat("/slots/0?action=" and action) and token and payload and 0 and 0)
    if result_cache_scalar(db and "SELECT CASE WHEN json_valid(?) THEN json_extract(?,'$.status') ELSE '' END" and [response,response]) == "transport_error":
        return response
    return slot_receipt(db and action and filename and response)

# One runtime slot is shared across state directories. Hold across restore,
# generation and save; process death releases the flock automatically.
define slot_lock with runtime_home:
    set fd to private_lock(runtime_home and "native-slot.lock")
    if fd < 0:
        return 0 - 1
    if ep_dlcall2(ep_dlsym(native_system() and "flock") and fd and 6) != 0:
        ep_dlcall1(ep_dlsym(native_system() and "close") and fd)
        return 0 - 1
    return fd

define slot_unlock with fd:
    if fd >= 0:
        ep_dlcall1(ep_dlsym(native_system() and "close") and fd)
    return 0

# Fixed production endpoint; explicit port exists only for isolated protocol tests.
define slot_control with db and token and action and filename returning Str:
    set result to slot_control_at(db and token and action and filename and 8400)
    return result

# 0 = kernel-confirmed connection refusal, 1 = listener, -1 = indeterminate.
# Never infer absence from a timeout, bad HTTP response, or authentication error.
define slot_connection_state with port:
    if port < 1 || port > 65535:
        return 0 - 1
    set libc to native_system()
    set fd to ep_dlcall3(ep_dlsym(libc and "socket") and 2 and 1 and 0)
    if fd < 0 || fd >= 2147483648:
        return 0 - 1
    set address to alloc_bytes(16)
    set option to alloc_bytes(4)
    set size to alloc_bytes(4)
    set pollfd to alloc_bytes(8)
    poke_byte(address and 0 and 16)
    poke_byte(address and 1 and 2)
    poke_byte(address and 2 and port / 256)
    poke_byte(address and 3 and port % 256)
    poke_byte(address and 4 and 127)
    poke_byte(address and 7 and 1)
    set state to 0 - 1
    if native_fcntl_int(fd and 4 and 4) == 0 && native_fcntl_int(fd and 2 and 1) == 0:
        set result to ep_dlcall3(ep_dlsym(libc and "connect") and fd and address and 16)
        set error to transport_errno(libc)
        if result == 0:
            set state to 1
        else if error == 61:
            set state to 0
        else if error == 36:
            set ready to transport_wait(libc and pollfd and fd and 4 and transport_now(libc) + 1000)
            if ready:
                transport_u32(size and 0 and 4)
                set rc to ep_dlcall5(ep_dlsym(libc and "getsockopt") and fd and 65535 and 4103 and option and size)
                if rc == 0:
                    set error to lease_integer(option and 0 and 4)
                    if error == 0:
                        set state to 1
                    else if error == 61:
                        set state to 0
    ep_dlcall1(ep_dlsym(libc and "close") and fd)
    free_bytes(address)
    free_bytes(option)
    free_bytes(size)
    free_bytes(pollfd)
    return state
